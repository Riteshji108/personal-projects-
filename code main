  if(skill.status==='In Progress' || hoursForSkill(skill.id)>0) return 'in-progress';
  return 'available';
}
function nodeIcon(st){ return st==='completed' ? 'check' : st==='locked' ? 'lock' : st==='in-progress' ? 'flame' : 'arrowRight'; }

