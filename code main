function drawResourceGrid(){
  const grid = document.getElementById('resGrid');
  if(!grid) return;
  const f = resourceFilters;
  const items = state.resources.filter(r=>{
    if(f.path!=='All' && r.path!==f.path) return false;
    if(f.skill!=='All' && r.skillId!==f.skill) return false;
    if(f.status!=='All' && r.status!==f.status) return false;
    if(f.onlyFav && !r.favorite) return false;
    if(f.search && !(r.name+' '+r.category+' '+r.notes).toLowerCase().includes(f.search.toLowerCase())) return false;
    return true;
  });
  if(!items.length){
    grid.innerHTML = `<div class="empty" style="grid-column:1/-1"><h4>No resources match</h4><p>Try clearing filters, or add a new resource to your library.</p><button class="btn btn-primary" id="emptyAddRes">Add resource</button></div>`;
    document.getElementById('emptyAddRes').onclick = ()=>openResourceModal(null);
    return;
  }
  grid.innerHTML = items.map(r=>{
    const skill = skillById(r.skillId);
    return `<div class="res-card">
      <div class="res-card-top">
        <h4>${escapeHtml(r.name)}</h4>
        <button class="fav-btn ${r.favorite?'active':''}" data-fav="${r.id}" aria-label="Toggle favorite">${icon('star')}</button>
      </div>
      <div class="meta">${escapeHtml(r.category)} · ${escapeHtml(r.path)}${skill?` · ${escapeHtml(skill.name)}`:''}</div>
      ${r.notes?`<div class="notes">${escapeHtml(r.notes)}</div>`:''}
      <span class="tag ${r.status==='Completed'?'tag-accent':r.status==='In Progress'?'tag-amber':'tag-muted'}" style="width:fit-content">${r.status}</span>
      <div class="res-actions">
        <a class="btn btn-sm" href="${escapeHtml(r.url)}" target="_blank" rel="noopener noreferrer" data-open="${r.id}">Open ${icon('ext')}</a>
        <button class="btn btn-sm" data-toggle="${r.id}">${r.status==='Completed'?'Mark in progress':'Mark complete'}</button>
        <button class="btn btn-sm btn-ghost" data-edit="${r.id}">Edit</button>
        <button class="btn btn-sm btn-ghost btn-danger" data-del="${r.id}">Delete</button>
      </div>
    </div>`;
  }).join('');

  grid.querySelectorAll('[data-fav]').forEach(b=>b.onclick=()=>{
    const r = state.resources.find(x=>x.id===b.dataset.fav); r.favorite = !r.favorite; saveState();
  });
  grid.querySelectorAll('[data-open]').forEach(a=>a.onclick=()=>{
    const r = state.resources.find(x=>x.id===a.dataset.open); if(r){ r.lastOpenedAt = new Date().toISOString(); saveState({skip:true}); }
  });
  grid.querySelectorAll('[data-toggle]').forEach(b=>b.onclick=()=>{
    const r = state.resources.find(x=>x.id===b.dataset.toggle); r.status = r.status==='Completed'?'In Progress':'Completed'; saveState();
  });
  grid.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>openResourceModal(state.resources.find(x=>x.id===b.dataset.edit)));
  grid.querySelectorAll('[data-del]').forEach(b=>b.onclick=()=>{
    if(!confirm('Delete this resource?')) return;
    state.resources = state.resources.filter(x=>x.id!==b.dataset.del); saveState(); showToast('Resource deleted.');
  });
}

