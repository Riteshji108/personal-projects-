===================================================================== */
function renderGoals(root){
  root.innerHTML = `
    <div class="page">
      <div class="page-head"><div><h1>Goals & notes</h1><p>Your reflections, targets, and the milestones you've earned along the way.</p></div></div>

      <div class="grid g2">
        <div class="panel">
          <label>Long-form notes</label>
          <textarea id="notesInput" style="min-height:140px" placeholder="Weekly reflection, blockers, key takeaways…">${escapeHtml(state.notes)}</textarea>
        </div>
        <div class="panel">
          <label>Main career goal</label>
          <textarea id="goalsInput" style="min-height:140px" placeholder="e.g. Become interview-ready for a Data Analyst role in 4 months">${escapeHtml(state.goals)}</textarea>
        </div>
      </div>
      <div style="display:flex; gap:.5rem; flex-wrap:wrap;">
        <button class="btn btn-primary" id="saveNotesBtn">Save notes & goal</button>
        <button class="btn" id="exportBtn">Export JSON</button>
        <label class="btn" style="cursor:pointer;">Import JSON<input id="importFile" type="file" accept="application/json" style="display:none"></label>
        <button class="btn btn-ghost btn-danger" id="resetBtn">Reset all data</button>
      </div>

      <div class="panel">
        <div class="section-title"><h3>Milestones & achievements</h3></div>
        <div class="grid g3" id="achievementGrid"></div>
      </div>
    </div>`;

  document.getElementById('saveNotesBtn').onclick = ()=>{
    state.notes = document.getElementById('notesInput').value;
    state.goals = document.getElementById('goalsInput').value;
    saveState(); showToast('Saved notes and goal.');
  };
  document.getElementById('exportBtn').onclick = ()=>{
    const blob = new Blob([JSON.stringify(state,null,2)], { type:'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href=url; a.download='pathwise-dashboard-backup.json'; a.click();
    URL.revokeObjectURL(url);
  };
  document.getElementById('importFile').onchange = e=>{
    const file = e.target.files?.[0]; if(!file) return;
    const reader = new FileReader();
    reader.onload = ()=>{
      try{ state = mergeState(JSON.parse(String(reader.result||'{}'))); saveState(); showToast('Import successful.'); }
      catch{ showToast('Invalid JSON import file.'); }
    };
    reader.readAsText(file);
  };
  document.getElementById('resetBtn').onclick = ()=>{
    if(!confirm('Reset all data to the starting catalog? This clears activity, notes and custom edits.')) return;
    state = defaultState(); saveState(); showToast('Data reset.');
  };

  const grid = document.getElementById('achievementGrid');
  grid.innerHTML = ACHIEVEMENTS.map(a=>{
    const done = a.test(state);
    const [cur,tgt] = a.progress(state);
    return `<div class="panel panel-tight" style="display:flex; gap:.7rem; align-items:flex-start; ${done?'border-color:var(--accent)':''}">
      <div style="width:34px;height:34px;border-radius:999px;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:${done?'var(--accent-soft)':'var(--surface-2)'};color:${done?'var(--accent)':'var(--text-faint)'}">${icon(done?'check':'lock')}</div>
      <div>
        <div style="font-weight:600; font-size:.9rem;">${escapeHtml(a.name)}</div>
        <div class="node-sub">${escapeHtml(a.desc)}</div>
        ${!done?`<div class="node-sub mono">${cur} / ${tgt}</div>`:''}
      </div>
    </div>`;
  }).join('');
}

