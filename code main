  { id:'model-deploy', name:'Model Deployment APIs', path:'ML Engineer', level:'Advanced', estHours:35, deps:['ml-fundamentals','software-eng'], resources:[{title:'FastAPI Docs',url:'https://fastapi.tiangolo.com/'}], order:2 },
  { id:'mlops-monitoring', name:'MLOps Monitoring & Drift', path:'ML Engineer', level:'Advanced', estHours:26, deps:['model-deploy'], resources:[{title:'Made With ML Ops',url:'https://madewithml.com/'}], order:3 }
].map(s => ({ ...s, status:'Not Started', notes:'', goal:'', isCustom:false, completedAt:null }));

const seedResources = [
  { id:'r1', name:'Kaggle Learn', url:'https://www.kaggle.com/learn', category:'Practice', notes:'Short applied courses with hands-on notebooks.', status:'Not Started', path:'Data Scientist', skillId:'python-basics', favorite:false, lastOpenedAt:null },
  { id:'r2', name:'DataTalksClub Zoomcamps', url:'https://github.com/DataTalksClub', category:'Bootcamp', notes:'Free cohort-based data engineering and ML courses.', status:'Not Started', path:'Data Engineer', skillId:'python-etl', favorite:false, lastOpenedAt:null }
];

const ACHIEVEMENTS = [
  { id:'first-skill', name:'First Skill Completed', desc:'Complete your first skill.', test:s => s.skills.filter(k=>k.status==='Completed').length >= 1, progress:s => [s.skills.filter(k=>k.status==='Completed').length, 1] },
  { id:'10h', name:'10 Hours Learned', desc:'Log 10 hours of focused learning.', test:s => totalHours(s) >= 10, progress:s => [Math.min(totalHours(s),10).toFixed(1), 10] },
  { id:'7day', name:'7-Day Streak', desc:'Keep a 7-day learning streak.', test:s => getStreaks(s).longest >= 7, progress:s => [getStreaks(s).longest, 7] },
  { id:'25h', name:'25 Hours Learned', desc:'Log 25 hours of focused learning.', test:s => totalHours(s) >= 25, progress:s => [Math.min(totalHours(s),25).toFixed(1), 25] },
  { id:'10skills', name:'10 Skills Completed', desc:'Complete 10 skills across any paths.', test:s => s.skills.filter(k=>k.status==='Completed').length >= 10, progress:s => [s.skills.filter(k=>k.status==='Completed').length, 10] },
  { id:'30day', name:'30-Day Streak', desc:'Keep a 30-day learning streak.', test:s => getStreaks(s).longest >= 30, progress:s => [getStreaks(s).longest, 30] },
  { id:'path-complete', name:'First Career Path Completed', desc:'Finish every skill in one career path.', test:s => PATH_NAMES.some(p => pathProgress(s,p) >= 100), progress:s => [Math.round(Math.max(...PATH_NAMES.map(p=>pathProgress(s,p)))), 100] },
  { id:'job-ready', name:'Job Ready', desc:'Complete your selected primary path end to end.', test:s => s.settings.primaryPath && pathProgress(s, s.settings.primaryPath) >= 100, progress:s => [Math.round(pathProgress(s, s.settings.primaryPath||PATH_NAMES[0])), 100] }
];

const DEFAULT_SETTINGS = {
  name:'', primaryPath:'', weeklyHoursTarget:10, weeklySkillsTarget:2, dailyHoursTarget:1,
  startDate: isoDate(new Date()), careerGoal:'', theme:'dark'
};

const SECTIONS = [
  { id:'dashboard', label:'Dashboard', icon:'grid' },
  { id:'paths', label:'Career Paths', icon:'compass' },
  { id:'roadmap', label:'Roadmap', icon:'route' },
  { id:'progress', label:'Progress', icon:'chart' },
  { id:'resources', label:'Resources', icon:'book' },
  { id:'skills', label:'Skills', icon:'layers' },
  { id:'activity', label:'Activity', icon:'flame' },
  { id:'goals', label:'Goals & Notes', icon:'target' }
];

/* =====================================================================
   ICONS (inline, self-contained)
===================================================================== */
const ICONS = {
  grid:'<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  compass:'<circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/>',
  route:'<circle cx="6" cy="6" r="2.3"/><circle cx="18" cy="18" r="2.3"/><path d="M6 8.3V13a4 4 0 0 0 4 4h4"/>',
  chart:'<path d="M4 20V10"/><path d="M12 20V4"/><path d="M20 20v-7"/>',
  book:'<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15.5H6.5A2.5 2.5 0 0 0 4 21z"/><path d="M4 18.5V5.5"/>',
  layers:'<path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5"/>',
  flame:'<path d="M12 2c1 3-2 4-2 7a4 4 0 0 0 8 0c0-2-1-3-1-3s2 2 2 6a7 7 0 0 1-14 0c0-5 4-6 5-10z"/>',
  target:'<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r=".8" fill="currentColor" stroke="none"/>',
  settings:'<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1 1.55V21a2 2 0 0 1-4 0v-.09A1.7 1.7 0 0 0 9 19.4a1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.55-1H3a2 2 0 0 1 0-4h.09A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-1.55V3a2 2 0 0 1 4 0v.09a1.7 1.7 0 0 0 1 1.55 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9a1.7 1.7 0 0 0 1.55 1H21a2 2 0 0 1 0 4h-.09a1.7 1.7 0 0 0-1.51 1z"/>',
