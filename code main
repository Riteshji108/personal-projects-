<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Pathwise — Data Career Learning Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
/* ============ TOKENS ============ */
:root{
  --bg:#f3f5f9; --bg-2:#eceff5; --surface:#ffffff; --surface-2:#f7f8fb;
  --border:#dde2ec; --border-soft:#e7eaf2;
  --text:#141922; --text-dim:#5b6577; --text-faint:#8892a3;
  --accent:#0f9488; --accent-soft:#0f948820;
  --amber:#b45309; --amber-soft:#b4530920;
  --violet:#6d5bd0; --violet-soft:#6d5bd020;
  --rose:#c33d75; --rose-soft:#c33d7520;
  --blue:#2f6fce; --blue-soft:#2f6fce20;
  --danger:#c2453f; --danger-soft:#c2453f1a;
  --shadow: 0 1px 2px rgba(20,25,34,.04), 0 8px 24px rgba(20,25,34,.06);
  --radius-s:8px; --radius-m:12px; --radius-l:18px;
  --font-display:'Space Grotesk', 'Segoe UI', system-ui, sans-serif;
  --font-body:'IBM Plex Sans', 'Segoe UI', system-ui, sans-serif;
  --font-mono:'IBM Plex Mono', 'SFMono-Regular', Consolas, monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0a0e14; --bg-2:#0d1219; --surface:#111826; --surface-2:#0d131d;
    --border:#232b3a; --border-soft:#1a212e;
    --text:#e9edf5; --text-dim:#9aa4b8; --text-faint:#6b7688;
    --accent:#39d6c4; --accent-soft:#39d6c422;
    --amber:#f0a83c; --amber-soft:#f0a83c22;
    --violet:#a793ff; --violet-soft:#a793ff22;
    --rose:#f27fac; --rose-soft:#f27fac22;
    --blue:#5b9bff; --blue-soft:#5b9bff22;
    --danger:#f16b64; --danger-soft:#f16b6422;
    --shadow: 0 1px 2px rgba(0,0,0,.3), 0 12px 30px rgba(0,0,0,.35);
  }
}
:root[data-theme="dark"]{
  --bg:#0a0e14; --bg-2:#0d1219; --surface:#111826; --surface-2:#0d131d;
  --border:#232b3a; --border-soft:#1a212e;
  --text:#e9edf5; --text-dim:#9aa4b8; --text-faint:#6b7688;
  --accent:#39d6c4; --accent-soft:#39d6c422;
  --amber:#f0a83c; --amber-soft:#f0a83c22;
  --violet:#a793ff; --violet-soft:#a793ff22;
  --rose:#f27fac; --rose-soft:#f27fac22;
  --blue:#5b9bff; --blue-soft:#5b9bff22;
  --danger:#f16b64; --danger-soft:#f16b6422;
  --shadow: 0 1px 2px rgba(0,0,0,.3), 0 12px 30px rgba(0,0,0,.35);
}
:root[data-theme="light"]{
  --bg:#f3f5f9; --bg-2:#eceff5; --surface:#ffffff; --surface-2:#f7f8fb;
  --border:#dde2ec; --border-soft:#e7eaf2;
  --text:#141922; --text-dim:#5b6577; --text-faint:#8892a3;
  --accent:#0f9488; --accent-soft:#0f948820;
  --amber:#b45309; --amber-soft:#b4530920;
  --violet:#6d5bd0; --violet-soft:#6d5bd020;
  --rose:#c33d75; --rose-soft:#c33d7520;
  --blue:#2f6fce; --blue-soft:#2f6fce20;
  --danger:#c2453f; --danger-soft:#c2453f1a;
  --shadow: 0 1px 2px rgba(20,25,34,.04), 0 8px 24px rgba(20,25,34,.06);
}

*{box-sizing:border-box;}
html,body{height:100%;}
body{
  margin:0; background:
    radial-gradient(1200px 600px at 100% -10%, var(--accent-soft), transparent 60%),
    var(--bg);
  color:var(--text); font-family:var(--font-body); -webkit-font-smoothing:antialiased;
  transition:background .3s ease,color .3s ease;
}
::selection{ background:var(--accent-soft); }
a{ color:var(--accent); text-decoration:none; }
a:hover{ text-decoration:underline; }
h1,h2,h3,h4{ font-family:var(--font-display); margin:0; letter-spacing:-0.01em; }
button{ font:inherit; }
:focus-visible{ outline:2px solid var(--accent); outline-offset:2px; border-radius:6px; }
.mono{ font-family:var(--font-mono); }
.hidden{ display:none !important; }
.sr-only{ position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0); }
@media (prefers-reduced-motion: reduce){
  *{ animation-duration:.001ms !important; transition-duration:.001ms !important; }
}

/* ============ APP SHELL ============ */
.app{ display:flex; min-height:100vh; }

.sidebar{
  width:236px; flex-shrink:0; background:var(--surface); border-right:1px solid var(--border);
  display:flex; flex-direction:column; padding:1.1rem .8rem; position:sticky; top:0; height:100vh;
}
.brand{ display:flex; align-items:center; gap:.55rem; padding:.3rem .5rem 1.1rem; }
.brand-mark{ width:30px; height:30px; border-radius:9px; background:linear-gradient(145deg,var(--accent),var(--blue)); display:flex; align-items:center; justify-content:center; color:#06110f; font-family:var(--font-display); font-weight:700; font-size:.95rem; flex-shrink:0; }
.brand-name{ font-family:var(--font-display); font-weight:700; font-size:1.02rem; }
.brand-sub{ font-size:.68rem; color:var(--text-faint); margin-top:-2px; }

.navlist{ display:flex; flex-direction:column; gap:.15rem; margin-top:.3rem; }
.navlist button{
  display:flex; align-items:center; gap:.65rem; text-align:left; background:none; border:none;
  color:var(--text-dim); padding:.55rem .6rem; border-radius:var(--radius-s); cursor:pointer; font-size:.88rem;
  transition:background .15s ease, color .15s ease;
}
.navlist button svg{ width:17px; height:17px; flex-shrink:0; opacity:.85; }
.navlist button:hover{ background:var(--surface-2); color:var(--text); }
.navlist button.active{ background:var(--accent-soft); color:var(--accent); font-weight:600; }
.navlist button.active svg{ opacity:1; }

.sidebar-foot{ margin-top:auto; display:flex; flex-direction:column; gap:.4rem; }
.streak-chip{
  display:flex; align-items:center; gap:.5rem; padding:.55rem .65rem; border-radius:var(--radius-s);
  background:var(--amber-soft); border:1px solid transparent; color:var(--amber); font-size:.82rem; font-weight:600;
}
.settings-btn{
  display:flex; align-items:center; gap:.6rem; padding:.5rem .6rem; border-radius:var(--radius-s);
  background:none; border:none; color:var(--text-dim); cursor:pointer; font-size:.85rem;
}
.settings-btn:hover{ background:var(--surface-2); color:var(--text); }
.settings-btn svg{ width:16px; height:16px; }

.topbar{
  position:sticky; top:0; z-index:40; display:flex; align-items:center; justify-content:space-between;
  gap:.8rem; padding:.85rem 1.4rem; background:color-mix(in srgb, var(--bg) 88%, transparent);
  backdrop-filter:blur(10px); border-bottom:1px solid var(--border-soft);
}
.topbar-title{ font-family:var(--font-display); font-weight:600; font-size:1.05rem; }
.topbar-actions{ display:flex; align-items:center; gap:.5rem; }
.search-trigger{
  display:flex; align-items:center; gap:.5rem; background:var(--surface); border:1px solid var(--border);
  color:var(--text-faint); padding:.42rem .6rem .42rem .55rem; border-radius:999px; cursor:pointer; font-size:.82rem;
}
.search-trigger kbd{ font-family:var(--font-mono); font-size:.68rem; background:var(--surface-2); border:1px solid var(--border); padding:.05rem .32rem; border-radius:5px; color:var(--text-faint); }
.icon-btn{
  display:flex; align-items:center; justify-content:center; width:34px; height:34px; border-radius:999px;
  background:var(--surface); border:1px solid var(--border); color:var(--text-dim); cursor:pointer;
}
.icon-btn:hover{ color:var(--text); border-color:var(--text-faint); }
.icon-btn svg{ width:16px; height:16px; }

.mobile-topbar{ display:none; }

main.content{ flex:1; min-width:0; padding:1.3rem 1.4rem 5rem; max-width:1180px; margin:0 auto; width:100%; }
.page{ display:flex; flex-direction:column; gap:1.3rem; }
.page-head{ display:flex; align-items:flex-end; justify-content:space-between; gap:1rem; flex-wrap:wrap; }
.page-head h1{ font-size:1.5rem; }
.page-head p{ margin:.2rem 0 0; color:var(--text-dim); font-size:.9rem; max-width:60ch; }
.eyebrow{ font-size:.72rem; color:var(--text-faint); margin-bottom:.15rem; }

/* ============ PRIMITIVES ============ */
.panel{ background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-m); padding:1.1rem; box-shadow:var(--shadow); }
.panel-tight{ padding:.85rem; }
.grid{ display:grid; gap:1rem; }
.g2{ grid-template-columns:repeat(2,minmax(0,1fr)); }
.g3{ grid-template-columns:repeat(3,minmax(0,1fr)); }
.g4{ grid-template-columns:repeat(4,minmax(0,1fr)); }
@media (max-width:980px){ .g4{ grid-template-columns:repeat(2,minmax(0,1fr)); } .g3{ grid-template-columns:repeat(2,minmax(0,1fr)); } }
@media (max-width:640px){ .g4,.g3,.g2{ grid-template-columns:1fr; } }

.btn{
  display:inline-flex; align-items:center; gap:.4rem; justify-content:center; padding:.5rem .85rem;
  border-radius:var(--radius-s); border:1px solid var(--border); background:var(--surface-2); color:var(--text);
  cursor:pointer; font-size:.85rem; font-weight:500; transition:transform .1s ease, border-color .15s ease, background .15s ease;
}
.btn:hover{ border-color:var(--text-faint); }
.btn:active{ transform:scale(.97); }
.btn-primary{ background:var(--accent); border-color:transparent; color:#062420; font-weight:600; }
:root[data-theme="light"] .btn-primary, :root:not([data-theme="dark"]) .btn-primary{ color:#022; }
.btn-primary:hover{ filter:brightness(1.06); border-color:transparent; }
.btn-ghost{ background:none; border-color:transparent; color:var(--text-dim); }
.btn-ghost:hover{ background:var(--surface-2); color:var(--text); }
.btn-danger{ color:var(--danger); }
.btn-sm{ padding:.32rem .6rem; font-size:.78rem; }
.btn svg{ width:14px; height:14px; }

label{ font-size:.78rem; color:var(--text-dim); display:block; margin-bottom:.28rem; }
input,select,textarea{
  width:100%; font:inherit; background:var(--surface-2); color:var(--text); border:1px solid var(--border);
  border-radius:var(--radius-s); padding:.5rem .6rem; font-size:.86rem; transition:border-color .15s ease;
}
input:focus,select:focus,textarea:focus{ border-color:var(--accent); }
textarea{ min-height:70px; resize:vertical; font-family:inherit; }
.field{ display:flex; flex-direction:column; }

.tag{ display:inline-flex; align-items:center; gap:.3rem; font-size:.7rem; font-weight:600; padding:.18rem .5rem; border-radius:999px; }
.tag-accent{ background:var(--accent-soft); color:var(--accent); }
.tag-amber{ background:var(--amber-soft); color:var(--amber); }
.tag-violet{ background:var(--violet-soft); color:var(--violet); }
.tag-rose{ background:var(--rose-soft); color:var(--rose); }
.tag-blue{ background:var(--blue-soft); color:var(--blue); }
.tag-muted{ background:var(--surface-2); color:var(--text-faint); border:1px solid var(--border); }

.divider{ height:1px; background:var(--border-soft); border:none; margin:0; }

.progress-track{ height:8px; border-radius:999px; background:var(--surface-2); border:1px solid var(--border-soft); overflow:hidden; }
.progress-fill{ height:100%; border-radius:999px; background:linear-gradient(90deg, var(--accent), var(--blue)); transition:width .5s cubic-bezier(.4,0,.2,1); }
.progress-fill.amber{ background:linear-gradient(90deg, var(--amber), #f4c76b); }

.toast-stack{ position:fixed; right:1rem; bottom:1rem; z-index:400; display:flex; flex-direction:column; gap:.5rem; align-items:flex-end; }
.toast{
  background:var(--surface); border:1px solid var(--border); color:var(--text); padding:.6rem .85rem; border-radius:var(--radius-s);
  box-shadow:var(--shadow); font-size:.84rem; max-width:300px; animation:toastIn .22s ease;
}
@keyframes toastIn{ from{ opacity:0; transform:translateY(6px); } to{ opacity:1; transform:none; } }

.empty{
  border:1px dashed var(--border); border-radius:var(--radius-m); padding:1.6rem 1.2rem; text-align:center;
  color:var(--text-dim); background:var(--surface-2);
}
.empty h4{ color:var(--text); font-size:.95rem; margin-bottom:.3rem; }
.empty p{ font-size:.83rem; margin:0 0 .7rem; }

/* ============ OVERVIEW ============ */
.hero-grid{ display:grid; grid-template-columns:1.15fr 1fr; gap:1rem; }
@media (max-width:900px){ .hero-grid{ grid-template-columns:1fr; } }

.hero-card{
  background:radial-gradient(600px 260px at 10% 0%, var(--accent-soft), transparent 60%), var(--surface);
  border:1px solid var(--border); border-radius:var(--radius-l); padding:1.3rem; box-shadow:var(--shadow);
  display:flex; gap:1.2rem; align-items:center; flex-wrap:wrap;
}
.ring-wrap{ position:relative; width:132px; height:132px; flex-shrink:0; }
.ring-wrap svg{ width:100%; height:100%; transform:rotate(-90deg); }
.ring-bg{ fill:none; stroke:var(--border-soft); stroke-width:10; }
.ring-fg{ fill:none; stroke:url(#ringGrad); stroke-width:10; stroke-linecap:round; transition:stroke-dashoffset .7s cubic-bezier(.4,0,.2,1); }
.ring-center{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; }
.ring-center .num{ font-family:var(--font-display); font-size:1.5rem; font-weight:700; }
.ring-center .lbl{ font-size:.65rem; color:var(--text-faint); text-transform:none; }

.hero-copy{ flex:1; min-width:180px; }
.hero-copy .eyebrow{ margin-bottom:.15rem; }
.hero-copy h2{ font-size:1.25rem; margin-bottom:.35rem; }
.hero-copy p{ color:var(--text-dim); font-size:.86rem; margin:0; }
.hero-stats{ display:flex; gap:1.4rem; margin-top:.85rem; flex-wrap:wrap; }
.hero-stat b{ display:block; font-family:var(--font-display); font-size:1.05rem; }
.hero-stat span{ font-size:.72rem; color:var(--text-faint); }

.streak-card{
  border-radius:var(--radius-l); border:1px solid var(--border); padding:1.3rem;
  background:radial-gradient(500px 220px at 90% 0%, var(--amber-soft), transparent 60%), var(--surface);
  box-shadow:var(--shadow); display:flex; flex-direction:column; justify-content:space-between; gap:.8rem;
}
.streak-top{ display:flex; align-items:center; justify-content:space-between; }
.streak-num{ font-family:var(--font-display); font-size:2.6rem; font-weight:700; color:var(--amber); line-height:1; transition:transform .25s ease; }
.streak-num.pulse{ animation:streakPulse .55s ease; }
@keyframes streakPulse{ 0%{ transform:scale(1);} 35%{ transform:scale(1.14);} 100%{ transform:scale(1);} }
.streak-flame{ width:34px; height:34px; color:var(--amber); }
.streak-note{ font-size:.82rem; color:var(--text-dim); }
.streak-meta{ display:flex; gap:1.1rem; font-size:.76rem; color:var(--text-faint); }
.streak-meta b{ color:var(--text); font-family:var(--font-mono); }

.continue-card{
  display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap;
  border-radius:var(--radius-l); border:1px solid var(--border); padding:1.1rem 1.3rem; box-shadow:var(--shadow);
  background:var(--surface);
}
.continue-info .eyebrow{ color:var(--accent); }
.continue-info h3{ font-size:1.15rem; margin:.15rem 0 .3rem; }
.continue-info .meta{ font-size:.8rem; color:var(--text-dim); display:flex; gap:.8rem; flex-wrap:wrap; }
.continue-bar{ width:220px; }
@media (max-width:640px){ .continue-bar{ width:100%; } }

.section-title{ display:flex; align-items:center; justify-content:space-between; margin-bottom:.1rem; }
.section-title h3{ font-size:1.02rem; }
.section-title a,.section-title button.link{ font-size:.8rem; color:var(--accent); background:none; border:none; cursor:pointer; }

.path-compare{ display:flex; flex-direction:column; gap:.7rem; }
.path-compare-row{ display:grid; grid-template-columns:130px 1fr 42px; align-items:center; gap:.7rem; }
.path-compare-row .pname{ font-size:.82rem; font-weight:600; }
.path-compare-row .pval{ font-size:.78rem; color:var(--text-faint); text-align:right; font-family:var(--font-mono); }

.mini-bars{ display:flex; align-items:flex-end; gap:6px; height:70px; }
.mini-bars .bar{ flex:1; background:var(--surface-2); border:1px solid var(--border-soft); border-radius:4px 4px 2px 2px; position:relative; min-height:3px; }
.mini-bars .bar > span{ position:absolute; bottom:0; left:0; right:0; border-radius:4px 4px 2px 2px; background:linear-gradient(180deg, var(--accent), var(--blue)); }
.mini-bars .lbl{ font-size:.62rem; color:var(--text-faint); text-align:center; margin-top:.3rem; }

.milestone-strip{ display:flex; gap:.6rem; overflow-x:auto; padding-bottom:.2rem; }
.milestone-chip{
  flex:0 0 auto; display:flex; align-items:center; gap:.5rem; padding:.5rem .75rem; border-radius:999px;
  border:1px solid var(--border); background:var(--surface-2); font-size:.78rem; color:var(--text-faint);
}
.milestone-chip.done{ border-color:transparent; background:var(--accent-soft); color:var(--accent); }
.milestone-chip svg{ width:14px; height:14px; }

.activity-feed{ display:flex; flex-direction:column; }
.activity-row{ display:flex; gap:.7rem; padding:.55rem 0; border-bottom:1px solid var(--border-soft); font-size:.83rem; }
.activity-row:last-child{ border-bottom:none; }
.activity-dot{ width:8px; height:8px; border-radius:999px; background:var(--accent); margin-top:.35rem; flex-shrink:0; }
.activity-row .d{ color:var(--text-faint); font-size:.74rem; font-family:var(--font-mono); min-width:74px; }
.activity-row .t{ color:var(--text); }
.activity-row .s{ color:var(--text-faint); }

/* ============ CAREER PATHS ============ */
.path-card{ border-radius:var(--radius-l); border:1px solid var(--border); background:var(--surface); box-shadow:var(--shadow); padding:1.1rem; display:flex; flex-direction:column; gap:.7rem; position:relative; overflow:hidden; }
.path-card::before{ content:''; position:absolute; inset:0 0 auto 0; height:3px; background:var(--pathColor,var(--accent)); }
.path-card-head{ display:flex; justify-content:space-between; align-items:flex-start; gap:.6rem; }
.path-card h3{ font-size:1.08rem; }
.path-card .desc{ font-size:.83rem; color:var(--text-dim); }
.path-ring-row{ display:flex; align-items:center; gap:.9rem; }
.path-mini-ring{ width:54px; height:54px; flex-shrink:0; }
.path-facts{ display:flex; gap:1rem; flex-wrap:wrap; font-size:.76rem; color:var(--text-faint); }
.path-facts b{ color:var(--text); font-family:var(--font-mono); font-weight:500; }
.tool-row{ display:flex; flex-wrap:wrap; gap:.35rem; }
.primary-star{ background:none; border:1px solid var(--border); color:var(--text-faint); border-radius:999px; width:28px; height:28px; display:flex; align-items:center; justify-content:center; cursor:pointer; flex-shrink:0; }
.primary-star.active{ color:var(--amber); border-color:var(--amber); background:var(--amber-soft); }
.primary-star svg{ width:15px; height:15px; }

/* ============ ROADMAP ============ */
.roadmap-tabs{ display:flex; gap:.4rem; flex-wrap:wrap; }
.roadmap-tabs button{
  border:1px solid var(--border); background:var(--surface); color:var(--text-dim); padding:.4rem .75rem;
  border-radius:999px; font-size:.82rem; cursor:pointer;
}
.roadmap-tabs button.active{ background:var(--tabColor,var(--accent)); border-color:transparent; color:#06110f; font-weight:600; }

.timeline{ position:relative; padding-left:34px; display:flex; flex-direction:column; gap:.15rem; }
.timeline::before{ content:''; position:absolute; left:13px; top:6px; bottom:6px; width:2px; background:var(--border); }
.node{ position:relative; padding:.65rem 0 1.05rem; }
.node-dot{
  position:absolute; left:-34px; top:.65rem; width:28px; height:28px; border-radius:999px; background:var(--surface);
  border:2px solid var(--border); display:flex; align-items:center; justify-content:center; color:var(--text-faint); z-index:2;
}
.node-dot svg{ width:13px; height:13px; }
.node.completed .node-dot{ border-color:var(--accent); background:var(--accent-soft); color:var(--accent); }
.node.in-progress .node-dot{ border-color:var(--amber); background:var(--amber-soft); color:var(--amber); }
.node.available .node-dot{ border-color:var(--blue); color:var(--blue); }
.node.locked .node-dot{ opacity:.55; }
.node-card{
  border:1px solid var(--border); background:var(--surface); border-radius:var(--radius-m); padding:.85rem 1rem;
  cursor:pointer; transition:border-color .15s ease, transform .1s ease;
}
.node-card:hover{ border-color:var(--text-faint); }
.node.locked .node-card{ opacity:.6; cursor:not-allowed; }
.node-head{ display:flex; justify-content:space-between; align-items:center; gap:.6rem; flex-wrap:wrap; }
.node-head h4{ font-size:.95rem; }
.node-sub{ font-size:.76rem; color:var(--text-faint); margin-top:.15rem; }
.node-progress{ margin-top:.55rem; display:flex; align-items:center; gap:.6rem; }
.node-progress .progress-track{ flex:1; }
.node-progress span{ font-size:.72rem; color:var(--text-faint); font-family:var(--font-mono); min-width:32px; text-align:right; }

.detail-panel{
  position:fixed; inset:0; z-index:300; display:flex; justify-content:flex-end; background:rgba(6,10,16,.45);
  animation:fadeIn .15s ease;
}
@keyframes fadeIn{ from{ opacity:0;} to{ opacity:1;} }
.detail-sheet{
  width:min(420px, 100%); background:var(--surface); height:100%; padding:1.3rem; overflow-y:auto;
  border-left:1px solid var(--border); animation:slideIn .2s ease;
}
@keyframes slideIn{ from{ transform:translateX(24px); opacity:0;} to{ transform:none; opacity:1;} }
.detail-close{ float:right; }
.detail-sheet h3{ font-size:1.15rem; margin-bottom:.2rem; }
.detail-sheet .dep-list{ display:flex; flex-wrap:wrap; gap:.35rem; margin-top:.3rem; }
.res-link-row{ display:flex; align-items:center; justify-content:space-between; padding:.5rem 0; border-bottom:1px solid var(--border-soft); font-size:.84rem; }

/* ============ MODAL ============ */
.modal-overlay{ position:fixed; inset:0; background:rgba(6,10,16,.5); display:flex; align-items:center; justify-content:center; z-index:350; padding:1rem; animation:fadeIn .15s ease; }
.modal{ width:min(560px,100%); max-height:88vh; overflow-y:auto; background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-l); padding:1.3rem; box-shadow:var(--shadow); animation:slideIn .18s ease; }
.modal-head{ display:flex; justify-content:space-between; align-items:center; margin-bottom:.9rem; }
.modal-head h3{ font-size:1.1rem; }

/* ============ COMMAND PALETTE ============ */
.cmdk-overlay{ position:fixed; inset:0; background:rgba(6,10,16,.5); z-index:500; display:flex; align-items:flex-start; justify-content:center; padding-top:10vh; }
.cmdk{ width:min(560px,92vw); background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-l); box-shadow:var(--shadow); overflow:hidden; }
.cmdk input{ border:none; border-bottom:1px solid var(--border-soft); border-radius:0; font-size:1rem; padding:.95rem 1.1rem; background:transparent; }
.cmdk input:focus{ border-bottom-color:var(--accent); }
.cmdk-results{ max-height:340px; overflow-y:auto; padding:.4rem; }
.cmdk-item{ display:flex; justify-content:space-between; gap:.6rem; padding:.6rem .7rem; border-radius:var(--radius-s); cursor:pointer; font-size:.87rem; }
.cmdk-item:hover, .cmdk-item.sel{ background:var(--surface-2); }
.cmdk-item .k-type{ font-size:.68rem; color:var(--text-faint); }
.cmdk-empty{ padding:1.2rem; text-align:center; color:var(--text-faint); font-size:.85rem; }

/* ============ RESOURCES / SKILLS ============ */
.filter-row{ display:flex; gap:.6rem; flex-wrap:wrap; align-items:flex-end; }
.filter-row .field{ min-width:150px; flex:1; }
.filter-row .field.search{ flex:2; min-width:200px; }

.res-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:.85rem; }
.res-card{ border:1px solid var(--border); background:var(--surface); border-radius:var(--radius-m); padding:.9rem; display:flex; flex-direction:column; gap:.5rem; box-shadow:var(--shadow); }
.res-card-top{ display:flex; justify-content:space-between; gap:.5rem; align-items:flex-start; }
.res-card h4{ font-size:.95rem; }
.res-card .meta{ font-size:.74rem; color:var(--text-faint); }
.res-card .notes{ font-size:.8rem; color:var(--text-dim); }
.res-actions{ display:flex; gap:.35rem; flex-wrap:wrap; margin-top:auto; padding-top:.4rem; }
.fav-btn{ background:none; border:none; cursor:pointer; color:var(--text-faint); padding:0; }
.fav-btn.active{ color:var(--amber); }
.fav-btn svg{ width:17px; height:17px; }

.recent-strip{ display:flex; gap:.6rem; overflow-x:auto; }
.recent-chip{ flex:0 0 auto; border:1px solid var(--border); background:var(--surface-2); border-radius:var(--radius-s); padding:.5rem .7rem; font-size:.78rem; min-width:150px; }
.recent-chip .n{ font-weight:600; display:block; margin-bottom:.1rem; }
.recent-chip .t{ color:var(--text-faint); font-size:.7rem; }

.skill-list-item{ border:1px solid var(--border); background:var(--surface); border-radius:var(--radius-m); padding:.85rem 1rem; display:flex; flex-direction:column; gap:.4rem; }
.skill-list-item .top{ display:flex; justify-content:space-between; gap:.6rem; align-items:flex-start; flex-wrap:wrap; }
.skill-list-item .name-row{ display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; }
.custom-dot{ width:6px; height:6px; border-radius:999px; background:var(--violet); display:inline-block; }

/* ============ ANALYTICS ============ */
.stat-card{ text-align:left; }
.stat-card .val{ font-family:var(--font-display); font-size:1.4rem; font-weight:700; }
.stat-card .lbl{ font-size:.76rem; color:var(--text-faint); margin-top:.1rem; }

.heat-wrap{ overflow-x:auto; padding-bottom:.3rem; }
.heatmap{ display:grid; grid-template-rows:repeat(7,13px); grid-auto-flow:column; grid-auto-columns:13px; gap:3px; }
.cell{ border-radius:3px; border:1px solid var(--border-soft); background:var(--surface-2); }
.lvl1{ background:color-mix(in srgb, var(--accent) 30%, var(--surface-2)); border-color:transparent; }
.lvl2{ background:color-mix(in srgb, var(--accent) 55%, var(--surface-2)); border-color:transparent; }
.lvl3{ background:color-mix(in srgb, var(--accent) 78%, var(--surface-2)); border-color:transparent; }
.lvl4{ background:var(--accent); border-color:transparent; }
.heat-scale{ display:flex; align-items:center; gap:.3rem; font-size:.68rem; color:var(--text-faint); margin-top:.4rem; }
.heat-scale .cell{ width:11px; height:11px; }

.weekly-goal-card{ display:flex; flex-direction:column; gap:.6rem; }
.wg-row{ display:flex; align-items:center; justify-content:space-between; font-size:.84rem; }
.wg-row .amt{ font-family:var(--font-mono); color:var(--text-faint); font-size:.78rem; }

/* ============ MOBILE BOTTOM NAV ============ */
.bottom-nav{ display:none; }
@media (max-width:880px){
  .sidebar{ display:none; }
  .mobile-topbar{
    display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:45;
    padding:.8rem 1rem; background:color-mix(in srgb, var(--bg) 90%, transparent); backdrop-filter:blur(10px);
    border-bottom:1px solid var(--border-soft);
  }
  main.content{ padding:1rem 1rem 5.5rem; }
  .bottom-nav{
    display:flex; position:fixed; bottom:0; left:0; right:0; z-index:60; background:var(--surface);
    border-top:1px solid var(--border); padding:.4rem .2rem calc(.4rem + env(safe-area-inset-bottom));
    overflow-x:auto;
  }
  .bottom-nav button{
    flex:1; min-width:64px; display:flex; flex-direction:column; align-items:center; gap:.2rem; background:none; border:none;
    color:var(--text-faint); padding:.3rem .1rem; font-size:.62rem; cursor:pointer;
  }
  .bottom-nav button svg{ width:18px; height:18px; }
  .bottom-nav button.active{ color:var(--accent); }
}
