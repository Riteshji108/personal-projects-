      <div class="page-head"><div><h1>Activity & analytics</h1><p>Log your sessions and see how consistent you've been.</p></div></div>

      <div class="grid g4">
        <div class="panel stat-card"><div class="val">${Number(state.activity[today]?.hours||0)}h</div><div class="lbl">Today</div></div>
        <div class="panel stat-card"><div class="val">${weekHours.toFixed(1)}h</div><div class="lbl">This week</div></div>
        <div class="panel stat-card"><div class="val">${hoursThisMonth().toFixed(1)}h</div><div class="lbl">This month</div></div>
        <div class="panel stat-card"><div class="val">${totalHours().toFixed(1)}h</div><div class="lbl">All time</div></div>
      </div>
      <div class="grid g4">
        <div class="panel stat-card"><div class="val">${activeDaysCount()}</div><div class="lbl">Active days</div></div>
        <div class="panel stat-card"><div class="val">${current}</div><div class="lbl">Current streak</div></div>
        <div class="panel stat-card"><div class="val">${longest}</div><div class="lbl">Longest streak</div></div>
        <div class="panel stat-card"><div class="val">${consistencyPct()}%</div><div class="lbl">Consistency since start</div></div>
      </div>

      <div class="grid g2">
        <div class="panel">
          <form id="activityForm">
            <div class="grid g3">
              <div class="field"><label>Date</label><input id="actDate" type="date" value="${today}" required/></div>
              <div class="field"><label>Hours</label><input id="actHours" type="number" step="0.25" min="0" value="1" required/></div>
              <div class="field"><label>Skill (optional)</label><select id="actSkill"><option value="">General</option>${state.skills.map(s=>`<option value="${s.id}">${escapeHtml(s.name)}</option>`).join('')}</select></div>
            </div>
            <div class="field" style="margin-top:.6rem"><label>Notes</label><input id="actNote" placeholder="What did you learn today?"/></div>
            <div style="display:flex; gap:.5rem; margin-top:.7rem;">
              <button class="btn btn-primary" type="submit">Log activity</button>
              <button class="btn btn-ghost" type="button" id="actDelete">Delete entry for date</button>
            </div>
          </form>
        </div>

        <div class="panel weekly-goal-card">
          <div class="section-title"><h3>Weekly goal</h3></div>
          <div class="wg-row"><span>Hours</span><span class="amt">${weekHours.toFixed(1)} / ${weekTarget}h</span></div>
          <div class="progress-track"><div class="progress-fill" style="width:${weekPct}%"></div></div>
          <div class="wg-row" style="margin-top:.4rem"><span>Skills completed</span><span class="amt">${skillsThisWeek} / ${skillsTarget}</span></div>
          <div class="progress-track"><div class="progress-fill amber" style="width:${clamp((skillsThisWeek/skillsTarget)*100,0,100)}%"></div></div>
          ${weekPct>=100 ? `<div class="node-sub" style="color:var(--accent)">Weekly hours goal reached — nice consistency.</div>` : ''}
        </div>
      </div>

      <div class="panel">
        <div class="section-title"><h3>Contribution heatmap</h3><span class="node-sub">Last 20 weeks · best day: ${best?`${best[0]} (${Number(best[1].hours).toFixed(1)}h)`:'—'}</span></div>
        <div class="heat-wrap"><div class="heatmap" id="heatmap"></div></div>
        <div class="heat-scale"><span>Less</span><div class="cell"></div><div class="cell lvl1"></div><div class="cell lvl2"></div><div class="cell lvl3"></div><div class="cell lvl4"></div><span>More</span></div>
      </div>

      <div class="panel">
        <div class="section-title"><h3>Recent activity</h3></div>
        ${renderActivityFeed(14)}
      </div>
    </div>`;

  const heat = document.getElementById('heatmap');
  const days = 140; const start = new Date(); start.setDate(start.getDate()-(days-1));
  let html='';
  for(let i=0;i<days;i++){
    const d = new Date(start); d.setDate(start.getDate()+i);
    const key = isoDate(d); const hours = Number(state.activity[key]?.hours||0);
    const lvl = hours===0?0:hours<1?1:hours<2?2:hours<4?3:4;
    html += `<div class="cell ${lvl?'lvl'+lvl:''}" title="${key}: ${hours}h"></div>`;
  }
  heat.innerHTML = html;

  document.getElementById('activityForm').onsubmit = e=>{
    e.preventDefault();
    const date = document.getElementById('actDate').value;
    const hours = Number(document.getElementById('actHours').value||0);
    if(!date) return showToast('Date is required.');
    if(hours<0) return showToast('Hours cannot be negative.');
    const skillId = document.getElementById('actSkill').value;
    const note = document.getElementById('actNote').value.trim();
    const prevStreakLongest = getStreaks().longest;
    state.activity[date] = { hours, skillId, note, topic: skillId ? (skillById(skillId)?.name||'') : '' };
    if(skillId){ const sk = skillById(skillId); if(sk && sk.status==='Not Started') sk.status='In Progress'; }
    saveState();
    if(date===today){ const numEl=document.getElementById('streakNum'); if(numEl) numEl.classList.add('pulse'); }
    showToast('Activity logged.');
  };
  document.getElementById('actDelete').onclick = ()=>{
    const date = document.getElementById('actDate').value;
    if(!date || !state.activity[date]) return showToast('No entry for that date.');
    delete state.activity[date]; saveState(); showToast('Entry removed.');
  };
}

/* =====================================================================
