  return days.map((d,i)=>{
    const h = hoursArr[i];
    const pct = (h/max)*100;
    const lbl = d.toLocaleDateString(undefined,{weekday:'narrow'});
    return `<div style="flex:1;display:flex;flex-direction:column;align-items:center;">
      <div class="bar" style="width:100%;"><span style="height:${pct}%"></span></div>
