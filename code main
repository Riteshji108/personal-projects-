  trash:'<path d="M4 7h16"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M6 7l1 13a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-13"/><path d="M9 7V4h6v3"/>',
  clock:'<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>',
  ext:'<path d="M14 4h6v6"/><path d="M10 14L20 4"/><path d="M20 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4"/>'
};
function icon(name, cls){ return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="${cls||''}">${ICONS[name]||''}</svg>`; }

/* =====================================================================
   STATE + STORAGE
===================================================================== */
function uid(){ return Math.random().toString(36).slice(2,10); }
function isoDate(d){ return d.toISOString().slice(0,10); }
function escapeHtml(str){
  return String(str==null?'':str)
    .replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;')
    .replaceAll('"','&quot;').replaceAll("'",'&#39;');
}
function clamp(n,min,max){ return Math.max(min, Math.min(max, n)); }
function statusWeight(status){ return status==='Completed' ? 1 : status==='In Progress' ? 0.5 : 0; }

function defaultState(){
  return {
    skills: JSON.parse(JSON.stringify(seedSkills)),
    resources: JSON.parse(JSON.stringify(seedResources)),
    activity: {},
    notes:'', goals:'',
    settings: { ...DEFAULT_SETTINGS }
  };
}

function mergeState(raw){
  const base = defaultState();
  if(!raw || typeof raw !== 'object') return base;
  const map = new Map(base.skills.map(s=>[s.id,s]));
  (raw.skills||[]).forEach(s=>{
    if(!s || !s.id) return;
    if(map.has(s.id)) map.set(s.id, { ...map.get(s.id), ...s, isCustom: !!map.get(s.id).isCustom && !s.hasOwnProperty('isCustom') ? map.get(s.id).isCustom : !!s.isCustom });
    else map.set(s.id, {
      id:s.id, name:s.name||'Custom Skill', path:s.path||PATH_NAMES[0], level:s.level||'Beginner',
      estHours:Number(s.estHours)||10, deps:Array.isArray(s.deps)?s.deps:[], resources:Array.isArray(s.resources)?s.resources:[],
      order:Number(s.order)||99, status:STATUS.includes(s.status)?s.status:'Not Started', notes:s.notes||'', goal:s.goal||'',
      isCustom:true, completedAt:s.completedAt||null
    });
  });
  return {
    skills: Array.from(map.values()),
    resources: Array.isArray(raw.resources) ? raw.resources.map(r=>({
      id:r.id||uid(), name:r.name||'Untitled', url:r.url||'', category:r.category||'General',
      notes:r.notes||'', status:STATUS.includes(r.status)?r.status:'Not Started', path:r.path||PATH_NAMES[0],
      skillId:r.skillId||'', favorite:!!r.favorite, lastOpenedAt:r.lastOpenedAt||null
    })) : base.resources,
    activity: raw.activity && typeof raw.activity==='object' ? raw.activity : {},
    notes: typeof raw.notes==='string' ? raw.notes : '',
    goals: typeof raw.goals==='string' ? raw.goals : '',
    settings: { ...DEFAULT_SETTINGS, ...(raw.settings||{}) }
  };
}

