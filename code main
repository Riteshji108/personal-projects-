/* =====================================================================
   DERIVED DATA HELPERS (state passed explicitly so they work in ACHIEVEMENTS too)
===================================================================== */
function skillById(id){ return state.skills.find(s=>s.id===id); }
function skillsForPath(path){ return state.skills.filter(s=>s.path===path).sort((a,b)=>a.order-b.order); }

function hoursForSkill(skillId, s){
  s = s || state;
  return Object.values(s.activity).reduce((sum,day)=> sum + (day.skillId===skillId ? Number(day.hours||0) : 0), 0);
}
function skillProgressPct(skill, s){
  s = s || state;
  if(skill.status==='Completed') return 100;
  const logged = hoursForSkill(skill.id, s);
  if(!skill.estHours) return 0;
  return clamp(Math.round((logged/skill.estHours)*100), 0, 99);
}
function lastStudiedDate(skillId, s){
  s = s || state;
  const dates = Object.entries(s.activity).filter(([,v])=>v.skillId===skillId).map(([d])=>d).sort();
  return dates.length ? dates[dates.length-1] : null;
}
function isSkillLocked(skill){
  if(!skill.deps || !skill.deps.length) return false;
  return skill.deps.some(dep => { const d=skillById(dep); return !d || d.status!=='Completed'; });
}
function pathProgress(s, path){
  s = s || state;
  const items = s.skills.filter(sk=>sk.path===path);
  if(!items.length) return 0;
  return (items.reduce((sum,sk)=>sum+statusWeight(sk.status),0)/items.length)*100;
}
function overallProgress(s){
  s = s || state;
  if(!s.skills.length) return 0;
  return (s.skills.reduce((sum,sk)=>sum+statusWeight(sk.status),0)/s.skills.length)*100;
}
function totalHours(s){ s = s || state; return Object.values(s.activity).reduce((sum,d)=>sum+Number(d.hours||0),0); }
function hoursInLastNDays(n, s){
  s = s || state;
  let total=0; const now=new Date();
  for(let i=0;i<n;i++){ const d=new Date(now); d.setDate(now.getDate()-i); total += Number(s.activity[isoDate(d)]?.hours||0); }
  return total;
}
function hoursThisMonth(s){
  s = s || state;
  const now = new Date(); const ym = now.toISOString().slice(0,7);
  return Object.entries(s.activity).filter(([d])=>d.startsWith(ym)).reduce((sum,[,v])=>sum+Number(v.hours||0),0);
}
function activeDaysCount(s){ s = s || state; return Object.values(s.activity).filter(d=>Number(d.hours||0)>0).length; }
function dayDiff(a,b){ return Math.round((new Date(b+'T00:00:00Z') - new Date(a+'T00:00:00Z'))/86400000); }
function getStreaks(s){
  s = s || state;
  const days = Object.keys(s.activity).filter(d=>Number(s.activity[d]?.hours||0)>0).sort();
  if(!days.length) return { current:0, longest:0 };
  let longest=1, run=1;
  for(let i=1;i<days.length;i++){ run = dayDiff(days[i-1],days[i])===1 ? run+1 : 1; longest = Math.max(longest,run); }
  let current=0, cursor=isoDate(new Date());
  while(s.activity[cursor] && Number(s.activity[cursor].hours||0)>0){ current++; cursor = isoDate(new Date(new Date(cursor).getTime()-86400000)); }
  return { current, longest };
}
function bestLearningDay(s){
  s = s || state;
  const entries = Object.entries(s.activity);
  if(!entries.length) return null;
  return entries.reduce((best,cur)=> Number(cur[1].hours||0) > Number((best?.[1]||{}).hours||0) ? cur : best, null);
}
function consistencyPct(s){
  s = s || state;
  const start = s.settings.startDate ? new Date(s.settings.startDate+'T00:00:00Z') : null;
  if(!start) return 0;
  const days = Math.max(1, dayDiff(isoDate(start), isoDate(new Date()))+1);
  return clamp(Math.round((activeDaysCount(s)/days)*100),0,100);
}
function nextRecommendedSkill(pathName){
  const list = skillsForPath(pathName).filter(s=>s.status!=='Completed' && !isSkillLocked(s));
  return list[0] || null;
}
function inProgressForPath(pathName){
  return skillsForPath(pathName)
    .filter(s=>s.status==='In Progress' || (s.status!=='Completed' && hoursForSkill(s.id)>0))
    .sort((a,b)=> skillProgressPct(b) - skillProgressPct(a))[0] || null;
}
function continueLearningSkill(){
  const primary = state.settings.primaryPath;
  const order = primary ? [primary, ...PATH_NAMES.filter(p=>p!==primary)] : PATH_NAMES;
  for(const p of order){ const s = inProgressForPath(p); if(s) return { skill:s, path:p }; }
  for(const p of order){ const s = nextRecommendedSkill(p); if(s) return { skill:s, path:p }; }
  return null;
}
function skillsCompletedInLastNDays(n, s){
  s = s || state; const cutoff = new Date(); cutoff.setDate(cutoff.getDate()-n+1);
  return s.skills.filter(sk=>sk.completedAt && new Date(sk.completedAt) >= new Date(isoDate(cutoff)+'T00:00:00Z')).length;
}

