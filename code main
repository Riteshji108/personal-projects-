function renderProgress(root){
  const rows = [...state.skills].sort((a,b)=>a.path.localeCompare(b.path)||a.order-b.order).map(s=>{
    const pct = skillProgressPct(s);
    return `<tr>
      <td><span class="tag tag-muted">${escapeHtml(s.path)}</span></td>
      <td>${escapeHtml(s.name)}${s.isCustom?' <span class="custom-dot" title="Custom skill"></span>':''}</td>
      <td>${s.level}</td>
      <td class="mono">${s.estHours}h</td>
      <td style="min-width:140px"><div class="progress-track"><div class="progress-fill" style="width:${pct}%"></div></div></td>
      <td><span class="tag ${s.status==='Completed'?'tag-accent':s.status==='In Progress'?'tag-amber':'tag-muted'}">${s.status}</span></td>
    </tr>`;
  }).join('');

  const last8Weeks = [];
  for(let i=7;i>=0;i--){
    const end = new Date(); end.setDate(end.getDate()-i*7);
    const start = new Date(end); start.setDate(end.getDate()-6);
    const count = state.skills.filter(s=>{
      if(!s.completedAt) return false;
      const d = new Date(s.completedAt+'T00:00:00Z');
      return d >= new Date(isoDate(start)+'T00:00:00Z') && d <= new Date(isoDate(end)+'T00:00:00Z');
    }).length;
    last8Weeks.push({ label:`${start.getMonth()+1}/${start.getDate()}`, count });
  }
  const maxW = Math.max(1, ...last8Weeks.map(w=>w.count));

  root.innerHTML = `
    <div class="page">
      <div class="page-head"><div><h1>Progress</h1><p>Every skill, its status and how far along you are, plus completions over time.</p></div></div>

      <div class="panel">
        <div class="section-title"><h3>Skills completed — last 8 weeks</h3></div>
        <div class="mini-bars" style="height:60px;">
          ${last8Weeks.map(w=>`<div style="flex:1;display:flex;flex-direction:column;align-items:center;">
            <div class="bar" style="width:100%"><span style="height:${(w.count/maxW)*100}%"></span></div>
            <div class="lbl">${w.label}</div>
          </div>`).join('')}
        </div>
      </div>

      <div class="panel" style="overflow:auto">
        <table style="width:100%; border-collapse:collapse;">
          <thead><tr style="text-align:left; font-size:.76rem; color:var(--text-faint);">
            <th style="padding:.4rem .3rem">Path</th><th style="padding:.4rem .3rem">Skill</th><th style="padding:.4rem .3rem">Level</th><th style="padding:.4rem .3rem">Est.</th><th style="padding:.4rem .3rem">Progress</th><th style="padding:.4rem .3rem">Status</th>
          </tr></thead>
          <tbody style="font-size:.86rem;">${rows}</tbody>
        </table>
      </div>
    </div>`;
  root.querySelectorAll('tbody tr').forEach(tr=>{}); // rows are read-only here; edits happen in Roadmap/Skills
}

