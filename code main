    <circle class="ring-bg" cx="${size/2}" cy="${size/2}" r="${r}"></circle>
    <circle class="ring-fg" cx="${size/2}" cy="${size/2}" r="${r}" stroke="${strokeColorVar||'url(#ringGrad)'}"
      stroke-dasharray="${c}" stroke-dashoffset="${offset}"></circle>
  </svg>`;
}

