<script>
'use strict';
/* =====================================================================
   CONFIG
===================================================================== */
const STORAGE_KEY = 'pathwiseDashboardV2';
const STATUS = ['Not Started','In Progress','Completed'];

const PATHS = {
  'Data Analyst':      { desc:'Transforms data into business insight using SQL, BI tooling, spreadsheets and storytelling.', color:'var(--accent)', tools:['SQL','Excel','Power BI','Tableau'], difficulty:'Beginner-friendly' },
  'Data Scientist':     { desc:'Builds predictive models and runs experiments with statistics, ML and clear communication.', color:'var(--violet)', tools:['Python','pandas','scikit-learn','Statistics'], difficulty:'Moderate' },
  'Data Engineer':      { desc:'Designs pipelines, storage and reliable data platforms that power analytics and ML.', color:'var(--amber)', tools:['Python','SQL','Airflow','Kafka'], difficulty:'Moderate–Advanced' },
  'Analytics Engineer': { desc:'Models trusted analytics datasets, metrics layers and semantic transformations.', color:'var(--rose)', tools:['SQL','dbt','Data modeling'], difficulty:'Moderate' },
  'ML Engineer':        { desc:'Productionizes models with deployment, monitoring and MLOps workflows.', color:'var(--blue)', tools:['Python','FastAPI','Docker','MLOps'], difficulty:'Advanced' }
};
const PATH_NAMES = Object.keys(PATHS);

const seedSkills = [
  { id:'sql-foundations', name:'SQL Foundations', path:'Data Analyst', level:'Beginner', estHours:25, deps:[], resources:[{title:'SQLBolt',url:'https://sqlbolt.com/'},{title:'Mode SQL Tutorial',url:'https://mode.com/sql-tutorial/'}], order:1 },
  { id:'excel-analysis', name:'Excel & Spreadsheets', path:'Data Analyst', level:'Beginner', estHours:20, deps:[], resources:[{title:'ExcelIsFun',url:'https://www.youtube.com/user/ExcelIsFun'}], order:2 },
  { id:'data-visualization', name:'Data Visualization (Tableau/Power BI)', path:'Data Analyst', level:'Intermediate', estHours:30, deps:['sql-foundations'], resources:[{title:'Microsoft Power BI Learning',url:'https://learn.microsoft.com/en-us/training/powerplatform/power-bi/'},{title:'Tableau Free Training',url:'https://www.tableau.com/learn/training'}], order:3 },
  { id:'ab-testing', name:'A/B Testing & Experimentation', path:'Data Analyst', level:'Advanced', estHours:22, deps:['data-visualization'], resources:[{title:'Khan Academy Statistics',url:'https://www.khanacademy.org/math/statistics-probability'}], order:4 },

  { id:'python-basics', name:'Python for Data Work', path:'Data Scientist', level:'Beginner', estHours:35, deps:[], resources:[{title:'Python Data Science Handbook',url:'https://jakevdp.github.io/PythonDataScienceHandbook/'},{title:'freeCodeCamp Python',url:'https://www.freecodecamp.org/learn/scientific-computing-with-python/'}], order:1 },
  { id:'stats-prob', name:'Statistics & Probability', path:'Data Scientist', level:'Beginner', estHours:40, deps:[], resources:[{title:'OpenIntro Statistics',url:'https://www.openintro.org/book/os/'}], order:2 },
  { id:'ml-fundamentals', name:'Machine Learning Fundamentals', path:'Data Scientist', level:'Intermediate', estHours:50, deps:['python-basics','stats-prob'], resources:[{title:'Hands-On ML (samples)',url:'https://github.com/ageron/handson-ml3'},{title:'Google ML Crash Course',url:'https://developers.google.com/machine-learning/crash-course'}], order:3 },
  { id:'model-evaluation', name:'Model Evaluation & Explainability', path:'Data Scientist', level:'Advanced', estHours:28, deps:['ml-fundamentals'], resources:[{title:'Interpretable ML',url:'https://christophm.github.io/interpretable-ml-book/'}], order:4 },

  { id:'python-etl', name:'Python ETL Scripting', path:'Data Engineer', level:'Beginner', estHours:30, deps:[], resources:[{title:'Real Python ETL',url:'https://realpython.com/python-data-cleaning-numpy-pandas/'}], order:1 },
  { id:'data-warehousing', name:'Data Warehousing Concepts', path:'Data Engineer', level:'Intermediate', estHours:35, deps:['python-etl'], resources:[{title:'Kimball Group Articles',url:'https://www.kimballgroup.com/data-warehouse-business-intelligence-resources/'}], order:2 },
  { id:'orchestration', name:'Workflow Orchestration (Airflow)', path:'Data Engineer', level:'Intermediate', estHours:30, deps:['python-etl'], resources:[{title:'Apache Airflow Docs',url:'https://airflow.apache.org/docs/'}], order:3 },
  { id:'streaming', name:'Streaming Data (Kafka Basics)', path:'Data Engineer', level:'Advanced', estHours:26, deps:['data-warehousing'], resources:[{title:'Confluent Kafka 101',url:'https://developer.confluent.io/learn-kafka/'}], order:4 },

  { id:'dbt-basics', name:'dbt Fundamentals', path:'Analytics Engineer', level:'Beginner', estHours:24, deps:['sql-foundations'], resources:[{title:'dbt Learn',url:'https://learn.getdbt.com/'}], order:1 },
  { id:'dimensional-modeling', name:'Dimensional Modeling', path:'Analytics Engineer', level:'Intermediate', estHours:30, deps:['dbt-basics'], resources:[{title:'The Data Warehouse Toolkit notes',url:'https://www.kimballgroup.com/'}], order:2 },
