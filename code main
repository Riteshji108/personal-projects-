/* =====================================================================
   COMMAND PALETTE
===================================================================== */
function buildCommandIndex(query){
  const q = query.trim().toLowerCase();
  const results = [];
  if(!q){
    return [
      ...SECTIONS.map(s=>({ type:'Section', label:s.label, action:()=>{ currentSection=s.id; renderApp(); } }))
    ];
  }
  state.skills.forEach(s=>{ if(s.name.toLowerCase().includes(q)) results.push({ type:'Skill', label:s.name, sub:s.path, action:()=>{ currentSection='roadmap'; roadmapActivePath=s.path; renderApp(()=>openSkillDetail(s.id)); } }); });
  state.resources.forEach(r=>{ if((r.name+' '+r.category).toLowerCase().includes(q)) results.push({ type:'Resource', label:r.name, sub:r.category, action:()=>{ currentSection='resources'; resourceFilters={search:r.name,path:'All',status:'All',skill:'All',onlyFav:false}; renderApp(); } }); });
  PATH_NAMES.forEach(p=>{ if(p.toLowerCase().includes(q)) results.push({ type:'Career path', label:p, action:()=>{ currentSection='paths'; renderApp(); } }); });
  if('notes'.includes(q) || (state.notes||'').toLowerCase().includes(q)) results.push({ type:'Notes', label:'Your notes', action:()=>{ currentSection='goals'; renderApp(); } });
  if('goals'.includes(q) || (state.goals||'').toLowerCase().includes(q)) results.push({ type:'Goal', label:'Your career goal', action:()=>{ currentSection='goals'; renderApp(); } });
  return results.slice(0,20);
}

function openCommandPalette(){
  const overlay = document.getElementById('overlayRoot');
  cmdkIndex = 0;
  overlay.innerHTML = `
    <div class="cmdk-overlay" id="cmdkOverlay">
      <div class="cmdk">
        <input id="cmdkInput" placeholder="Search skills, resources, paths, notes…" autofocus />
        <div class="cmdk-results" id="cmdkResults"></div>
      </div>
    </div>`;
  const input = document.getElementById('cmdkInput');
  const resultsEl = document.getElementById('cmdkResults');
  let results = [];

  function draw(){
    results = buildCommandIndex(input.value);
    if(!results.length){ resultsEl.innerHTML = `<div class="cmdk-empty">No matches. Try a different search.</div>`; return; }
    resultsEl.innerHTML = results.map((r,i)=>`<div class="cmdk-item ${i===cmdkIndex?'sel':''}" data-idx="${i}"><span>${escapeHtml(r.label)}${r.sub?` <span class="node-sub" style="display:inline">· ${escapeHtml(r.sub)}</span>`:''}</span><span class="k-type">${escapeHtml(r.type)}</span></div>`).join('');
    resultsEl.querySelectorAll('[data-idx]').forEach(el=>el.onclick = ()=>{ results[Number(el.dataset.idx)].action(); closeOverlay(); });
  }
  draw();
  input.oninput = ()=>{ cmdkIndex=0; draw(); };
  input.onkeydown = e=>{
    if(e.key==='ArrowDown'){ e.preventDefault(); cmdkIndex = Math.min(results.length-1, cmdkIndex+1); draw(); }
    else if(e.key==='ArrowUp'){ e.preventDefault(); cmdkIndex = Math.max(0, cmdkIndex-1); draw(); }
    else if(e.key==='Enter'){ e.preventDefault(); if(results[cmdkIndex]){ results[cmdkIndex].action(); closeOverlay(); } }
    else if(e.key==='Escape'){ closeOverlay(); }
  };
  document.getElementById('cmdkOverlay').addEventListener('click', e=>{ if(e.target.id==='cmdkOverlay') closeOverlay(); });
  setTimeout(()=>input.focus(), 30);
}

document.addEventListener('keydown', e=>{
  if((e.metaKey||e.ctrlKey) && e.key.toLowerCase()==='k'){ e.preventDefault(); openCommandPalette(); }
  else if(e.key==='Escape'){ const ov=document.getElementById('overlayRoot'); if(ov.innerHTML) closeOverlay(); }
});

/* =====================================================================
   APP RENDER ROOT
===================================================================== */
function renderApp(after){
  renderShell();
  const root = document.getElementById('pageRoot');
  ({
    dashboard: renderDashboard,
    paths: renderPaths,
    roadmap: renderRoadmap,
    progress: renderProgress,
    resources: renderResources,
    skills: renderSkills,
    activity: renderActivity,
    goals: renderGoals
  }[currentSection] || renderDashboard)(root);
  if(typeof after === 'function') setTimeout(after, 20);
}

applyTheme();
renderApp();
</script>
