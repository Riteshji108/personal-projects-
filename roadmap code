<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Data Career Learning Dashboard</title>
  <style>
    :root {
      --bg:#070b14;
      --bg-alt:#0d1323;
      --surface:#111a2e;
      --surface-2:#16233d;
      --surface-3:#1a2c4d;
      --border:#2a3e67;
      --text:#ecf2ff;
      --muted:#9db0d9;
      --accent:#5e8cff;
      --accent-2:#34c0ff;
      --good:#3fd18f;
      --warn:#f7bc46;
      --danger:#f66a74;
      --shadow:0 14px 36px rgba(0,0,0,.35);
      --radius:16px;
      --radius-sm:12px;
    }

    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;
      font-family:Inter,Segoe UI,Roboto,system-ui,-apple-system,sans-serif;
      color:var(--text);
      background:radial-gradient(1200px 700px at 100% -10%,rgba(86,123,255,.2),transparent),radial-gradient(700px 700px at -10% 100%,rgba(65,179,255,.16),transparent),var(--bg);
    }

    a{color:#a9d4ff;text-decoration:none}
    a:hover{text-decoration:underline}

    .app{
      min-height:100vh;
      display:grid;
      grid-template-columns:280px 1fr;
    }

    .sidebar{
      border-right:1px solid var(--border);
      background:linear-gradient(180deg,rgba(17,26,46,.96),rgba(10,16,31,.96));
      backdrop-filter:blur(8px);
      padding:1.1rem;
      position:sticky;
      top:0;
      height:100vh;
      overflow:auto;
    }

    .brand{display:flex;align-items:center;gap:.7rem;margin-bottom:1.1rem}
    .brand .logo{
      width:38px;height:38px;border-radius:12px;
      background:linear-gradient(145deg,var(--accent),var(--accent-2));
      display:grid;place-items:center;font-weight:700;color:white;
      box-shadow:0 10px 20px rgba(69,139,255,.3)
    }
    .brand h1{margin:0;font-size:1rem;line-height:1.15}
    .brand small{display:block;color:var(--muted);font-size:.74rem}

    .demo-tag{padding:.5rem .65rem;border:1px dashed var(--border);border-radius:12px;background:rgba(34,52,88,.35);font-size:.78rem;color:var(--muted);margin-bottom:.9rem}

    .nav-list{display:grid;gap:.34rem}
    .nav-btn{
      border:1px solid transparent;
      background:transparent;
      color:var(--text);
      text-align:left;
      border-radius:12px;
      padding:.62rem .72rem;
      display:flex;align-items:center;gap:.55rem;
      cursor:pointer;
      transition:.22s ease;
    }
    .nav-btn:hover{background:rgba(73,115,213,.15);border-color:rgba(115,157,255,.2)}
    .nav-btn.active{background:linear-gradient(90deg,rgba(80,126,255,.28),rgba(80,194,255,.2));border-color:rgba(140,179,255,.42)}
    .nav-icon{width:20px;text-align:center;opacity:.95}

    .main{display:flex;flex-direction:column;min-width:0}

    .topbar{
      position:sticky;top:0;z-index:50;
      background:rgba(8,13,24,.76);
      backdrop-filter:blur(9px);
      border-bottom:1px solid var(--border);
      padding:.85rem 1.15rem;
      display:flex;align-items:center;justify-content:space-between;gap:.8rem;flex-wrap:wrap;
    }

    .topbar-left{display:flex;align-items:center;gap:.7rem;flex-wrap:wrap}
    .topbar h2{margin:0;font-size:1.1rem}
    .kbtn,.btn{
      border:1px solid var(--border);
      background:var(--surface-2);
      color:var(--text);
      border-radius:11px;
      padding:.5rem .72rem;
      cursor:pointer;
      transition:.2s ease;
    }
    .kbtn:hover,.btn:hover{transform:translateY(-1px);border-color:#6a91df}
    .btn.primary{background:linear-gradient(130deg,var(--accent),#4ca9ff);border-color:transparent;color:#fff}
    .btn.ghost{background:transparent}
    .btn.warn{background:rgba(247,188,70,.12);border-color:rgba(247,188,70,.35);color:#ffd894}

    .top-profile{display:flex;align-items:center;gap:.6rem;padding:.35rem .55rem;border:1px solid var(--border);border-radius:999px;background:rgba(36,53,86,.5)}
    .avatar{width:26px;height:26px;border-radius:50%;background:linear-gradient(130deg,#5e8cff,#4ed2ff);display:grid;place-items:center;font-size:.8rem;font-weight:700;color:white}

    .content{padding:1rem 1.15rem 5rem;display:grid;gap:1rem}

    .surface{background:linear-gradient(180deg,rgba(20,30,52,.9),rgba(14,22,39,.9));border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);padding:1rem}
    .surface.flat{box-shadow:none}
    .surface h3,.surface h4{margin:.2rem 0 .5rem}
    .muted{color:var(--muted)}
    .tiny{font-size:.8rem}

    .grid{display:grid;gap:.85rem}
    .g2{grid-template-columns:repeat(2,minmax(0,1fr))}
    .g3{grid-template-columns:repeat(3,minmax(0,1fr))}
    .g4{grid-template-columns:repeat(4,minmax(0,1fr))}

    .metric{font-size:1.65rem;font-weight:700;line-height:1}
    .metric-sub{font-size:.82rem;color:var(--muted)}

    .hero{
      display:grid;
      grid-template-columns:1.4fr 1fr;
      gap:.9rem;
      align-items:stretch;
    }

    .ring-wrap{display:flex;gap:1rem;align-items:center;flex-wrap:wrap}
    .ring{width:170px;height:170px;position:relative}
    .ring svg{transform:rotate(-90deg)}
    .ring .center{position:absolute;inset:0;display:grid;place-items:center;text-align:center}
    .ring .center strong{font-size:1.55rem}

    .pill{display:inline-flex;align-items:center;border:1px solid var(--border);padding:.17rem .5rem;border-radius:999px;font-size:.75rem;background:rgba(32,47,79,.64);gap:.35rem}
    .st-good{color:var(--good)} .st-warn{color:var(--warn)} .st-bad{color:var(--danger)}

    .progress-track{height:9px;border-radius:99px;background:#0d1730;border:1px solid var(--border);overflow:hidden}
    .progress-track > span{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--accent),var(--accent-2));transition:width .5s ease}

    .subtle-list{display:grid;gap:.45rem}
    .subtle-item{display:flex;justify-content:space-between;gap:.4rem;padding:.48rem .58rem;border-radius:10px;background:rgba(20,31,56,.52);border:1px solid rgba(76,104,161,.36)}

    .section{display:none;animation:fade .25s ease}
    .section.active{display:block}
    @keyframes fade{from{opacity:.5;transform:translateY(4px)}to{opacity:1;transform:none}}

    .timeline{position:relative;display:grid;gap:.6rem;padding-left:1rem}
    .timeline:before{content:"";position:absolute;left:.42rem;top:.2rem;bottom:.2rem;width:2px;background:linear-gradient(var(--accent),rgba(94,140,255,.1))}
    .node{position:relative;padding:.6rem .7rem .65rem .8rem;border:1px solid var(--border);border-radius:12px;background:rgba(26,41,71,.55);cursor:pointer;transition:.2s ease}
    .node:before{content:"";position:absolute;left:-.94rem;top:1rem;width:.7rem;height:.7rem;border-radius:50%;border:2px solid #8ab3ff;background:#1a2f56}
    .node:hover{transform:translateX(2px)}
    .node.completed{border-color:rgba(66,203,145,.45)}
    .node.completed:before{background:var(--good);border-color:rgba(66,203,145,.42)}
    .node.inprogress{border-color:rgba(247,188,70,.5)}
    .node.inprogress:before{background:var(--warn);border-color:rgba(247,188,70,.45)}
    .node.locked{opacity:.58}

    .label-row{display:flex;flex-wrap:wrap;gap:.35rem}

    input,select,textarea{
      width:100%;
      background:#0f1933;
      color:var(--text);
      border:1px solid var(--border);
      border-radius:10px;
      padding:.52rem .62rem;
      font:inherit;
      transition:border-color .2s ease, box-shadow .2s ease;
    }
    textarea{min-height:80px;resize:vertical}
    input:focus,select:focus,textarea:focus,.btn:focus,.nav-btn:focus,.kbtn:focus{outline:none;border-color:#78a3ff;box-shadow:0 0 0 3px rgba(106,149,255,.18)}

    .field{display:grid;gap:.25rem}
    .field label{font-size:.82rem;color:var(--muted)}

    .resource-card,.skill-card{border:1px solid var(--border);border-radius:13px;background:rgba(20,31,55,.56);padding:.75rem}
    .resource-card:hover,.skill-card:hover{border-color:rgba(129,166,240,.52)}

    .table-wrap{overflow:auto}
    table{width:100%;border-collapse:collapse}
    th,td{padding:.52rem .32rem;border-bottom:1px solid rgba(79,108,168,.35);text-align:left;vertical-align:top}
    th{color:#bfd2f8;font-size:.78rem;text-transform:uppercase;letter-spacing:.04em}
    td{font-size:.9rem}

    .heatmap{display:grid;grid-template-rows:repeat(7,13px);grid-auto-flow:column;grid-auto-columns:13px;gap:4px;overflow:auto;padding:.3rem 0 .5rem}
    .cell{border:1px solid rgba(62,87,137,.56);border-radius:3px;background:#0b162f}
    .l1{background:#163864}.l2{background:#2360a1}.l3{background:#2d86d4}.l4{background:#45b8ff}

    .chart{display:flex;align-items:flex-end;gap:8px;height:150px;padding:.45rem .4rem .2rem;border:1px solid var(--border);border-radius:12px;background:rgba(13,21,38,.7)}
    .bar{flex:1;display:flex;flex-direction:column;align-items:center;gap:.3rem}
    .bar .fill{width:100%;border-radius:8px 8px 3px 3px;min-height:2px;background:linear-gradient(180deg,#66b8ff,#557dff);transition:height .5s ease}
    .bar small{color:var(--muted);font-size:.68rem}

    .ach-list{display:grid;gap:.46rem}
    .ach{display:flex;justify-content:space-between;gap:.5rem;padding:.5rem .58rem;border:1px solid rgba(90,118,177,.35);border-radius:10px;background:rgba(16,27,48,.65)}
    .ach.done{border-color:rgba(64,200,140,.45);background:rgba(31,64,53,.28)}

    .drawer, .palette{position:fixed;inset:0;background:rgba(4,8,16,.65);backdrop-filter:blur(4px);display:none;z-index:200}
    .drawer.open,.palette.open{display:grid;place-items:center;animation:fade .2s ease}
    .drawer-panel,.palette-panel{width:min(900px,92vw);max-height:86vh;overflow:auto;background:linear-gradient(180deg,#101a30,#0d162a);border:1px solid var(--border);border-radius:18px;box-shadow:var(--shadow);padding:1rem}
    .palette-panel{width:min(760px,92vw)}

    .result-item{padding:.52rem .58rem;border-radius:10px;border:1px solid rgba(79,108,168,.35);background:rgba(20,31,56,.52);cursor:pointer}
    .result-item:hover{border-color:#7da7ff}

    .toast{position:fixed;right:1rem;bottom:1rem;z-index:250;background:#10203f;border:1px solid var(--border);padding:.6rem .8rem;border-radius:12px;display:none;max-width:340px;box-shadow:var(--shadow)}

    .mobile-nav{display:none;position:fixed;left:0;right:0;bottom:0;z-index:90;background:rgba(10,16,30,.94);border-top:1px solid var(--border);padding:.34rem .45rem}
    .mobile-nav .row{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:.24rem}
    .mnav{border:1px solid transparent;background:transparent;color:var(--muted);padding:.3rem .2rem;border-radius:10px;font-size:.69rem;display:grid;justify-items:center;gap:.18rem;cursor:pointer}
    .mnav.active{color:var(--text);border-color:rgba(132,170,249,.35);background:rgba(80,126,255,.15)}

    .celebrate{animation:pulse .8s ease}
    @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(63,209,143,.45)}100%{box-shadow:0 0 0 18px rgba(63,209,143,0)}}

    .hidden{display:none!important}

    @media (max-width:1120px){
      .hero{grid-template-columns:1fr}
      .g4{grid-template-columns:repeat(2,minmax(0,1fr))}
      .g3{grid-template-columns:repeat(2,minmax(0,1fr))}
    }

    @media (max-width:900px){
      .app{grid-template-columns:1fr}
      .sidebar{display:none}
      .mobile-nav{display:block}
      .content{padding-bottom:5.7rem}
    }

    @media (max-width:700px){
      .g4,.g3,.g2{grid-template-columns:1fr}
      .ring{width:145px;height:145px}
    }
  </style>
</head>
<body>
  <div class="app">
    <aside class="sidebar" aria-label="Main navigation">
      <div class="brand">
        <div class="logo">DL</div>
        <div>
          <h1>Data Learning OS</h1>
          <small>Career growth dashboard</small>
        </div>
      </div>
      <div id="demoTag" class="demo-tag"></div>
      <div id="desktopNav" class="nav-list"></div>
    </aside>

    <div class="main">
      <header class="topbar">
        <div class="topbar-left">
          <h2 id="sectionTitle">Dashboard</h2>
          <button id="searchBtn" class="kbtn" type="button">⌘/Ctrl + K Search</button>
        </div>
        <div class="top-profile">
          <div class="avatar" id="topAvatar">U</div>
          <div>
            <div id="topName" class="tiny">Learner</div>
            <div id="topPath" class="tiny muted">Primary Path</div>
          </div>
        </div>
      </header>

      <main class="content">
        <section id="storageNotice" class="surface hidden"></section>
        <section id="dashboardSection" class="section active"></section>
        <section id="careerSection" class="section"></section>
        <section id="roadmapSection" class="section"></section>
        <section id="progressSection" class="section"></section>
        <section id="resourcesSection" class="section"></section>
        <section id="skillsSection" class="section"></section>
        <section id="activitySection" class="section"></section>
        <section id="goalsSection" class="section"></section>
      </main>
    </div>
  </div>

  <nav class="mobile-nav" aria-label="Mobile navigation">
    <div id="mobileNav" class="row"></div>
  </nav>

  <div id="skillDrawer" class="drawer" aria-hidden="true">
    <div class="drawer-panel">
      <div style="display:flex;justify-content:space-between;gap:.6rem;align-items:center;flex-wrap:wrap">
        <h3 id="drawerTitle" style="margin:.1rem 0">Skill detail</h3>
        <button class="btn ghost" id="drawerClose" type="button">Close</button>
      </div>
      <div id="drawerBody"></div>
    </div>
  </div>

  <div id="palette" class="palette" aria-hidden="true">
    <div class="palette-panel">
      <div class="field">
        <label for="paletteInput">Search skills, resources, paths, notes, goals</label>
        <input id="paletteInput" placeholder="Try: SQL, streak, Data Engineer..." />
      </div>
      <div id="paletteResults" class="grid" style="margin-top:.7rem"></div>
      <div class="tiny muted" style="margin-top:.5rem">Enter to open first result • Esc to close</div>
    </div>
  </div>

  <div id="toast" class="toast" role="status" aria-live="polite"></div>

  <script>
    const STORAGE_KEY = 'dataCareerDashboardV1';
    const STATUS_OPTIONS = ['Not Started', 'In Progress', 'Completed'];
    const LEVELS = ['Beginner', 'Intermediate', 'Advanced'];
    const PATHS = {
      'Data Analyst': {desc:'Transforms data into business insights using SQL, BI, spreadsheets, and storytelling.', difficulty:'Moderate', tools:['SQL','Excel','Power BI','Tableau','A/B Testing']},
      'Data Scientist': {desc:'Builds predictive models and experimentation workflows with stats and machine learning.', difficulty:'High', tools:['Python','Pandas','Scikit-learn','Statistics','Experimentation']},
      'Data Engineer': {desc:'Builds pipelines, warehousing, and reliable data infrastructure for analytics/ML.', difficulty:'High', tools:['Python','SQL','Airflow','Kafka','Warehousing']},
      'Analytics Engineer': {desc:'Designs trusted data models and semantic layers for reliable analytics.', difficulty:'Moderate', tools:['dbt','SQL','Modeling','Metrics Layer']},
      'ML Engineer': {desc:'Deploys models in production and operates robust MLOps systems.', difficulty:'Very High', tools:['APIs','Docker','Monitoring','CI/CD','MLOps']}
    };

    const NAV_ITEMS = [
      {id:'dashboard',label:'Dashboard',icon:'📊',section:'dashboardSection'},
      {id:'career',label:'Career Paths',icon:'🧭',section:'careerSection'},
      {id:'roadmap',label:'Roadmap',icon:'🗺️',section:'roadmapSection'},
      {id:'progress',label:'Progress',icon:'📈',section:'progressSection'},
      {id:'resources',label:'Resources',icon:'📚',section:'resourcesSection'},
      {id:'skills',label:'Skills',icon:'🧠',section:'skillsSection'},
      {id:'activity',label:'Activity',icon:'🔥',section:'activitySection'},
      {id:'goals',label:'Goals & Notes',icon:'🎯',section:'goalsSection'}
    ];

    const PHASE_BY_LEVEL = {Beginner:'Foundation',Intermediate:'Core Skills',Advanced:'Advanced Skills'};

    const seedSkills = [
      { id:'sql-foundations', name:'SQL Foundations', path:'Data Analyst', level:'Beginner', estHours:25, deps:[], resources:[{title:'SQLBolt',url:'https://sqlbolt.com/'},{title:'Mode SQL Tutorial',url:'https://mode.com/sql-tutorial/'}], order:1 },
      { id:'excel-analysis', name:'Excel & Spreadsheets', path:'Data Analyst', level:'Beginner', estHours:20, deps:[], resources:[{title:'ExcelIsFun',url:'https://www.youtube.com/user/ExcelIsFun'}], order:2 },
      { id:'data-visualization', name:'Data Visualization (Tableau/Power BI)', path:'Data Analyst', level:'Intermediate', estHours:30, deps:['sql-foundations'], resources:[{title:'Microsoft Power BI Learning',url:'https://learn.microsoft.com/en-us/training/powerplatform/power-bi/'},{title:'Tableau Free Training',url:'https://www.tableau.com/learn/training'}], order:3 },
      { id:'ab-testing', name:'A/B Testing & Experimentation', path:'Data Analyst', level:'Advanced', estHours:22, deps:['data-visualization'], resources:[{title:'Khan Academy Statistics',url:'https://www.khanacademy.org/math/statistics-probability'}], order:4 },
      { id:'python-basics', name:'Python for Data Work', path:'Data Scientist', level:'Beginner', estHours:35, deps:[], resources:[{title:'Python Data Science Handbook',url:'https://jakevdp.github.io/PythonDataScienceHandbook/'},{title:'freeCodeCamp Python',url:'https://www.freecodecamp.org/learn/scientific-computing-with-python/'}], order:1 },
      { id:'stats-prob', name:'Statistics & Probability', path:'Data Scientist', level:'Beginner', estHours:40, deps:[], resources:[{title:'OpenIntro Statistics',url:'https://www.openintro.org/book/os/'}], order:2 },
      { id:'ml-fundamentals', name:'Machine Learning Fundamentals', path:'Data Scientist', level:'Intermediate', estHours:50, deps:['python-basics','stats-prob'], resources:[{title:'Hands-On ML Samples',url:'https://github.com/ageron/handson-ml3'},{title:'Google ML Crash Course',url:'https://developers.google.com/machine-learning/crash-course'}], order:3 },
      { id:'model-evaluation', name:'Model Evaluation & Explainability', path:'Data Scientist', level:'Advanced', estHours:28, deps:['ml-fundamentals'], resources:[{title:'Interpretable ML',url:'https://christophm.github.io/interpretable-ml-book/'}], order:4 },
      { id:'python-etl', name:'Python ETL Scripting', path:'Data Engineer', level:'Beginner', estHours:30, deps:[], resources:[{title:'Real Python ETL',url:'https://realpython.com/python-data-cleaning-numpy-pandas/'}], order:1 },
      { id:'data-warehousing', name:'Data Warehousing Concepts', path:'Data Engineer', level:'Intermediate', estHours:35, deps:['python-etl'], resources:[{title:'Kimball Group Articles',url:'https://www.kimballgroup.com/data-warehouse-business-intelligence-resources/'}], order:2 },
      { id:'orchestration', name:'Workflow Orchestration (Airflow)', path:'Data Engineer', level:'Intermediate', estHours:30, deps:['python-etl'], resources:[{title:'Apache Airflow Docs',url:'https://airflow.apache.org/docs/'}], order:3 },
      { id:'streaming', name:'Streaming Data (Kafka Basics)', path:'Data Engineer', level:'Advanced', estHours:26, deps:['data-warehousing'], resources:[{title:'Confluent Kafka 101',url:'https://developer.confluent.io/learn-kafka/'}], order:4 },
      { id:'dbt-basics', name:'dbt Fundamentals', path:'Analytics Engineer', level:'Beginner', estHours:24, deps:['sql-foundations'], resources:[{title:'dbt Learn',url:'https://learn.getdbt.com/'}], order:1 },
      { id:'dimensional-modeling', name:'Dimensional Modeling', path:'Analytics Engineer', level:'Intermediate', estHours:30, deps:['dbt-basics'], resources:[{title:'Kimball Group',url:'https://www.kimballgroup.com/'}], order:2 },
      { id:'metrics-layer', name:'Metrics Layer & Semantic Models', path:'Analytics Engineer', level:'Advanced', estHours:28, deps:['dimensional-modeling'], resources:[{title:'dbt Blog',url:'https://www.getdbt.com/blog'}], order:3 },
      { id:'software-eng', name:'Software Engineering for ML', path:'ML Engineer', level:'Intermediate', estHours:30, deps:['python-basics'], resources:[{title:'Full Stack Deep Learning',url:'https://fullstackdeeplearning.com/'}], order:1 },
      { id:'model-deploy', name:'Model Deployment APIs', path:'ML Engineer', level:'Advanced', estHours:35, deps:['ml-fundamentals','software-eng'], resources:[{title:'FastAPI Docs',url:'https://fastapi.tiangolo.com/'}], order:2 },
      { id:'mlops-monitoring', name:'MLOps Monitoring & Drift', path:'ML Engineer', level:'Advanced', estHours:26, deps:['model-deploy'], resources:[{title:'Made With ML',url:'https://madewithml.com/'}], order:3 }
    ].map(s => ({...s,status:'Not Started',notes:'',goal:'',targetDate:'',lastStudiedDate:'',isCustom:false,optional:false}));

    const seedResources = [
      {id:uid(),name:'Kaggle Learn',url:'https://www.kaggle.com/learn',category:'Practice',type:'Course',notes:'Short applied modules',status:'Not Started',path:'Data Scientist',skillId:'python-basics',favorite:false,lastOpenedAt:''},
      {id:uid(),name:'DataTalksClub Zoomcamps',url:'https://github.com/DataTalksClub',category:'Bootcamp',type:'Program',notes:'Practical tracks for DE/ML',status:'Not Started',path:'Data Engineer',skillId:'python-etl',favorite:false,lastOpenedAt:''}
    ];

    const defaultSettings = () => ({
      name:'Learner',
      primaryPath:'Data Analyst',
      weeklyHoursTarget:10,
      weeklySkillsTarget:2,
      streakTarget:7,
      dailyHoursTarget:1,
      preferredHours:'Morning',
      theme:'Dark',
      startDate:isoDate(new Date()),
      careerGoal:''
    });

    const defaultState = () => ({
      skills:structuredClone(seedSkills),
      resources:structuredClone(seedResources),
      activity:{},
      notes:'',
      goals:'',
      settings:defaultSettings(),
      selectedPath:'Data Analyst',
      isDemoData:true
    });

    const storage = (() => {
      try {
        localStorage.setItem('__dash_test__','1');
        localStorage.removeItem('__dash_test__');
        return {
          available:true,
          read(){
            const raw = localStorage.getItem(STORAGE_KEY);
            if(!raw) return defaultState();
            return mergeState(JSON.parse(raw));
          },
          write(state){ localStorage.setItem(STORAGE_KEY,JSON.stringify(state)); }
        }
      } catch {
        let mem = defaultState();
        return { available:false, read(){return mem;}, write(state){mem = state;} }
      }
    })();

    let state = storage.read();
    const ui = {section:'dashboard', skillDrawerId:'', paletteOpen:false};

    function mergeState(raw){
      const base = defaultState();
      if(!raw || typeof raw !== 'object') return base;
      const map = new Map(base.skills.map(s => [s.id,s]));
      (raw.skills||[]).forEach(s => {
        if(!s || !s.id) return;
        if(map.has(s.id)) map.set(s.id,{...map.get(s.id),...s,isCustom:!!s.isCustom});
        else map.set(s.id,{
          id:s.id,name:s.name||'Custom Skill',path:s.path||'Data Analyst',level:LEVELS.includes(s.level)?s.level:'Beginner',
          estHours:Math.max(1,Number(s.estHours)||1),deps:Array.isArray(s.deps)?s.deps:[],resources:Array.isArray(s.resources)?s.resources:[],
          order:Number(s.order)||999,status:STATUS_OPTIONS.includes(s.status)?s.status:'Not Started',notes:s.notes||'',goal:s.goal||'',targetDate:s.targetDate||'',lastStudiedDate:s.lastStudiedDate||'',isCustom:true,optional:!!s.optional
        });
      });
      return {
        skills:[...map.values()],
        resources:Array.isArray(raw.resources)?raw.resources.map(r => ({
          id:r.id||uid(),name:r.name||'Untitled',url:r.url||'',category:r.category||'General',type:r.type||'Resource',notes:r.notes||'',
          status:STATUS_OPTIONS.includes(r.status)?r.status:'Not Started',path:r.path||'Data Analyst',skillId:r.skillId||'',favorite:!!r.favorite,lastOpenedAt:r.lastOpenedAt||''
        })):base.resources,
        activity:raw.activity && typeof raw.activity === 'object' ? raw.activity : {},
        notes:typeof raw.notes==='string'?raw.notes:'',
        goals:typeof raw.goals==='string'?raw.goals:'',
        settings:{...defaultSettings(),...(raw.settings||{})},
        selectedPath:raw.selectedPath || raw.settings?.primaryPath || 'Data Analyst',
        isDemoData: typeof raw.isDemoData === 'boolean' ? raw.isDemoData : true
      }
    }

    function persist(markReal=true){
      if(markReal) state.isDemoData = false;
      try { storage.write(state); } catch { toast('Unable to save now. Storage may be unavailable.'); }
      renderAll();
    }

    function uid(){ return Math.random().toString(36).slice(2,10); }
    function isoDate(d){ return d.toISOString().slice(0,10); }
    function esc(s){ return String(s??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#39;'); }

    function toast(msg){
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.style.display = 'block';
      clearTimeout(toast.tm);
      toast.tm = setTimeout(()=>t.style.display='none',2200);
    }

    function statusWeight(status){ return status==='Completed'?1:status==='In Progress'?0.5:0; }
    function skillById(id){ return state.skills.find(s=>s.id===id); }
    function skillsByPath(path){ return state.skills.filter(s=>s.path===path).sort((a,b)=>a.order-b.order); }
    function depsMet(skill){ return (skill.deps||[]).every(d => skillById(d)?.status === 'Completed'); }

    function overallProgress(){
      if(!state.skills.length) return 0;
      return state.skills.reduce((a,s)=>a+statusWeight(s.status),0)/state.skills.length;
    }

    function pathProgress(path){
      const items = skillsByPath(path);
      if(!items.length) return 0;
      return items.reduce((a,s)=>a+statusWeight(s.status),0)/items.length;
    }

    function pathHours(path){ return skillsByPath(path).reduce((a,s)=>a+Number(s.estHours||0),0); }
    function completedSkillsCount(path){ return skillsByPath(path).filter(s=>s.status==='Completed').length; }

    function totalHours(){ return Object.values(state.activity).reduce((a,v)=>a + Number(v.hours||0),0); }
    function hoursForRange(days){
      let sum=0; const now = new Date();
      for(let i=0;i<days;i++){ const d=new Date(now); d.setDate(now.getDate()-i); sum += Number(state.activity[isoDate(d)]?.hours||0); }
      return sum;
    }
    function monthHours(){
      let sum=0; const now = new Date();
      for(const [k,v] of Object.entries(state.activity)){
        const d = new Date(k+'T00:00:00');
        if(d.getMonth()===now.getMonth() && d.getFullYear()===now.getFullYear()) sum += Number(v.hours||0);
      }
      return sum;
    }

    function streakInfo(){
      const days = Object.keys(state.activity).filter(d=>Number(state.activity[d]?.hours||0)>0).sort();
      if(!days.length) return {current:0,longest:0,activeDays:0,bestDay:null};
      let longest=1, run=1;
      for(let i=1;i<days.length;i++){
        if(dayDiff(days[i-1],days[i])===1) run++; else run=1;
        if(run>longest) longest=run;
      }
      let current=0; let cursor = isoDate(new Date());
      while(state.activity[cursor] && Number(state.activity[cursor].hours||0)>0){
        current++; cursor = shiftDate(cursor,-1);
      }
      let bestDay = null;
      for(const [d,v] of Object.entries(state.activity)){
        const h=Number(v.hours||0);
        if(!bestDay || h > bestDay.hours) bestDay={date:d,hours:h};
      }
      return {current,longest,activeDays:days.length,bestDay};
    }

    function dayDiff(a,b){ return Math.round((new Date(b+'T00:00:00Z')-new Date(a+'T00:00:00Z'))/86400000); }
    function shiftDate(iso,delta){ const d=new Date(iso+'T00:00:00'); d.setDate(d.getDate()+delta); return isoDate(d); }

    function consistencyPercent(){
      const s = state.settings.startDate || isoDate(new Date());
      const days = Math.max(1, dayDiff(s,isoDate(new Date()))+1);
      return Math.min(100, Math.round((streakInfo().activeDays/days)*100));
    }

    function weeklyComparison(){
      const thisWeek = hoursForRange(7);
      let prev = 0;
      for(let i=7;i<14;i++){ const d = shiftDate(isoDate(new Date()),-i); prev += Number(state.activity[d]?.hours||0); }
      return {thisWeek,prevWeek:prev,delta:thisWeek-prev};
    }

    function nextBestSkill(){
      const path = state.settings.primaryPath || state.selectedPath || 'Data Analyst';
      const candidates = skillsByPath(path).filter(s=>s.status!=='Completed');
      const available = candidates.filter(s=>depsMet(s));
      const pool = available.length ? available : candidates;
      if(!pool.length) return null;
      return pool.sort((a,b)=>a.order-b.order)[0];
    }

    function remainingHours(skill){
      if(skill.status==='Completed') return 0;
      if(skill.status==='In Progress') return Math.max(1,Math.round(skill.estHours*0.4));
      return Number(skill.estHours||0);
    }

    function learningLevel(){
      const p = overallProgress()*100;
      if(p >= 85) return 'Job Ready';
      if(p >= 65) return 'Advanced';
      if(p >= 35) return 'Intermediate';
      return 'Foundation';
    }

    function momentumLabel(){
      const d = weeklyComparison().delta;
      if(d>1) return 'Rising';
      if(d<-1) return 'Cooling';
      return 'Stable';
    }

    function todayActivityDone(){ return Number(state.activity[isoDate(new Date())]?.hours||0) > 0; }

    function achievements(){
      const s = streakInfo();
      const completed = state.skills.filter(k=>k.status==='Completed').length;
