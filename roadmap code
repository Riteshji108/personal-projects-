          el.querySelector('#skillTarget').value = s.targetDate||'';
          el.querySelector('#skillNotes').value = s.notes||'';
          Array.from(el.querySelector('#skillDeps').options).forEach(opt => opt.selected = (s.deps||[]).includes(opt.value));
          toast('Skill loaded for editing.');
        });

        holder.querySelectorAll('[data-open-skill]').forEach(btn => btn.onclick = () => openSkillDrawer(btn.dataset.openSkill));

        holder.querySelectorAll('[data-del-skill]').forEach(btn => btn.onclick = () => {
          if(!confirm('Delete this custom skill?')) return;
          const id = btn.dataset.delSkill;
          state.skills = state.skills.filter(s=>s.id!==id);
          state.resources = state.resources.map(r => r.skillId===id ? {...r,skillId:''} : r);
          persist();
        });
      };

      ['skillSearch','skillPathFilter','skillStatusFilter'].forEach(id=>{
        el.querySelector('#'+id).oninput = redraw;
        el.querySelector('#'+id).onchange = redraw;
      });
      redraw();
    }

    function weeklyBarsData(){
      const arr = [];
      for(let w=7;w>=0;w--){
        let sum = 0;
        for(let i=0;i<7;i++){
          const day = shiftDate(isoDate(new Date()),-(w*7+i));
          sum += Number(state.activity[day]?.hours||0);
        }
        arr.push(sum);
      }
      return arr;
    }

    function renderActivity(){
      const el = document.getElementById('activitySection');
      const today = isoDate(new Date());
      const streak = streakInfo();
      const weekly = weeklyComparison();
      const weeklyGoalPct = Math.min(100, Math.round((weekly.thisWeek/Math.max(1,Number(state.settings.weeklyHoursTarget||10)))*100));
      const bars = weeklyBarsData();
      const max = Math.max(1,...bars);

      el.innerHTML = `
        <div class="grid g3">
          <div class="surface ${todayActivityDone()?'celebrate':''}">
            <div class="tiny muted">Current streak</div>
            <div class="metric" style="font-size:2.4rem" data-count="${streak.current}">${streak.current}</div>
            <div class="tiny muted">Longest streak: ${streak.longest} days</div>
            <div style="margin-top:.45rem" class="progress-track"><span style="width:${Math.min(100,Math.round((streak.current/Math.max(1,Number(state.settings.streakTarget||7)))*100))}%"></span></div>
            <div class="tiny muted" style="margin-top:.35rem">Weekly streak goal: ${Number(state.settings.streakTarget||7)} days</div>
          </div>
          <div class="surface"><div class="tiny muted">Consistency</div><div class="metric" data-count="${consistencyPercent()}">${consistencyPercent()}</div><div class="metric-sub">% active days</div><div class="tiny muted" style="margin-top:.4rem">Total active days: ${streak.activeDays}</div></div>
          <div class="surface"><div class="tiny muted">Weekly activity</div><div class="metric">${weekly.thisWeek.toFixed(1)}h</div><div class="metric-sub">${weekly.delta>=0?'+':''}${weekly.delta.toFixed(1)}h vs previous week</div><div class="tiny muted" style="margin-top:.4rem">Best day: ${streak.bestDay?`${streak.bestDay.date} (${streak.bestDay.hours}h)`:'No activity yet'}</div></div>
        </div>

        <div class="grid g2" style="margin-top:.8rem">
          <div class="surface">
            <h4>Log Learning Activity</h4>
            <form id="activityForm">
              <div class="grid g3">
                <div class="field"><label>Date</label><input id="actDate" type="date" value="${today}" required /></div>
                <div class="field"><label>Hours</label><input id="actHours" type="number" step="0.25" min="0" value="1" required /></div>
                <div class="field"><label>Skill</label><select id="actSkill"><option value="">General</option>${state.skills.map(s=>`<option value="${s.id}">${esc(s.name)}</option>`).join('')}</select></div>
              </div>
              <div class="grid g2" style="margin-top:.55rem">
                <div class="field"><label>Topic</label><input id="actTopic" placeholder="e.g. SQL Joins" /></div>
                <div class="field"><label>Notes</label><input id="actNote" placeholder="What did you learn?" /></div>
              </div>
              <div style="display:flex;gap:.45rem;flex-wrap:wrap;margin-top:.7rem"><button class="btn primary" type="submit">Save Activity</button><button class="btn" id="actDelete" type="button">Delete Day Entry</button></div>
            </form>
            <div class="surface flat" style="margin-top:.7rem"><strong>Weekly goal</strong><div class="tiny muted">${weekly.thisWeek.toFixed(1)} / ${Number(state.settings.weeklyHoursTarget||10)} hours</div><div style="margin-top:.4rem" class="progress-track"><span style="width:${weeklyGoalPct}%"></span></div></div>
          </div>

          <div class="surface">
            <h4>Streak Calendar & Heatmap</h4>
            <div id="heatmap" class="heatmap"></div>
            <div class="tiny muted">Dark = none, brighter = more learning hours for the day.</div>
            <h4 style="margin-top:.8rem">Weekly trend (last 8 weeks)</h4>
            <div class="chart">${bars.map((v,idx)=>`<div class="bar"><div class="fill" style="height:${Math.max(4,Math.round((v/max)*120))}px"></div><small>W${idx+1}</small></div>`).join('')}</div>
          </div>
        </div>

        <div class="grid g2" style="margin-top:.8rem">
          <div class="surface">
            <h4>Recent activity</h4>
            ${renderActivityListMarkup(12,false)}
          </div>
          <div class="surface">
            <h4>Milestones & Achievements</h4>
            <div class="ach-list">${achievements().map(a => `<div class="ach ${a.done?'done':''}"><span>${a.title}</span><strong>${a.done?'Unlocked':'In Progress'}</strong></div>`).join('')}</div>
            <div class="tiny muted" style="margin-top:.55rem">Milestones are based only on your actual saved activity and progress.</div>
          </div>
        </div>
      `;

      const form = el.querySelector('#activityForm');
      form.onsubmit = (ev) => {
        ev.preventDefault();
        const date = el.querySelector('#actDate').value;
        const hours = Number(el.querySelector('#actHours').value||0);
        const skillId = el.querySelector('#actSkill').value;
        const topic = el.querySelector('#actTopic').value.trim();
        const note = el.querySelector('#actNote').value.trim();
        if(!date) return toast('Date is required.');
        if(hours < 0) return toast('Hours cannot be negative.');
        state.activity[date] = {hours,skillId,topic,note};
        if(skillId && skillById(skillId)) skillById(skillId).lastStudiedDate = date;
        persist();
        if(date===isoDate(new Date()) && hours>0) toast('Today logged — streak updated.');
      };

      el.querySelector('#actDelete').onclick = () => {
        const date = el.querySelector('#actDate').value;
        if(!date || !state.activity[date]) return toast('No entry for selected date.');
        delete state.activity[date];
        persist();
      };

      renderHeatmap(el.querySelector('#heatmap'));
      animateCounters(el);
    }

    function renderHeatmap(container){
      const days = 182;
      const start = new Date();
      start.setDate(start.getDate()-(days-1));
      container.innerHTML = '';
      for(let i=0;i<days;i++){
        const d = new Date(start); d.setDate(start.getDate()+i);
        const key = isoDate(d);
        const h = Number(state.activity[key]?.hours||0);
        const lvl = h===0?0:h<1?1:h<2?2:h<4?3:4;
        const c = document.createElement('div');
        c.className = `cell ${lvl?`l${lvl}`:''}`;
        c.title = `${key}: ${h}h`;
        container.appendChild(c);
      }
    }

    function renderGoals(){
      const el = document.getElementById('goalsSection');
      el.innerHTML = `
        <div class="grid g2">
          <div class="surface">
            <h3>Goals & Notes</h3>
            <div class="field"><label>Career goal</label><input id="careerGoalInput" value="${esc(state.settings.careerGoal||'')}" placeholder="e.g. Become interview-ready Data Analyst in 4 months" /></div>
            <div class="field" style="margin-top:.6rem"><label>Learning goals</label><textarea id="globalGoals">${esc(state.goals||'')}</textarea></div>
            <div class="field" style="margin-top:.6rem"><label>Notes</label><textarea id="globalNotes">${esc(state.notes||'')}</textarea></div>
            <div style="display:flex;gap:.45rem;flex-wrap:wrap;margin-top:.65rem"><button class="btn primary" id="saveNotesBtn" type="button">Save Goals & Notes</button></div>
          </div>

          <div class="surface">
            <h3>Profile & Preferences</h3>
            <div class="grid g2">
              <div class="field"><label>Name</label><input id="setName" value="${esc(state.settings.name||'Learner')}" /></div>
              <div class="field"><label>Primary career path</label><select id="setPrimaryPath">${Object.keys(PATHS).map(p=>`<option ${p===state.settings.primaryPath?'selected':''}>${esc(p)}</option>`).join('')}</select></div>
              <div class="field"><label>Weekly hours target</label><input id="setWeeklyHours" type="number" min="1" value="${Number(state.settings.weeklyHoursTarget||10)}" /></div>
              <div class="field"><label>Weekly skills target</label><input id="setWeeklySkills" type="number" min="1" value="${Number(state.settings.weeklySkillsTarget||2)}" /></div>
              <div class="field"><label>Streak target (days)</label><input id="setStreakTarget" type="number" min="1" value="${Number(state.settings.streakTarget||7)}" /></div>
              <div class="field"><label>Daily hours target</label><input id="setDailyTarget" type="number" min="0.25" step="0.25" value="${Number(state.settings.dailyHoursTarget||1)}" /></div>
              <div class="field"><label>Preferred learning time</label><input id="setPreferredHours" value="${esc(state.settings.preferredHours||'')}" /></div>
              <div class="field"><label>Start date</label><input id="setStartDate" type="date" value="${esc(state.settings.startDate||isoDate(new Date()))}" /></div>
            </div>
            <div style="display:flex;gap:.45rem;flex-wrap:wrap;margin-top:.7rem"><button class="btn primary" id="saveSettingsBtn" type="button">Save Settings</button></div>
          </div>
        </div>

        <div class="surface" style="margin-top:.8rem">
          <h3>Backup & Data Controls</h3>
          <div class="muted tiny">Export/import JSON to preserve your learning history. Reset restores seed roadmap and clears personal progress.</div>
          <div style="display:flex;gap:.45rem;flex-wrap:wrap;margin-top:.7rem">
            <button class="btn" id="exportBtn" type="button">Export JSON</button>
            <label class="btn" style="cursor:pointer">Import JSON<input id="importInput" type="file" accept="application/json" style="display:none"></label>
            <button class="btn warn" id="resetBtn" type="button">Reset to Demo Data</button>
          </div>
        </div>
      `;

      el.querySelector('#saveNotesBtn').onclick = () => {
        state.settings.careerGoal = el.querySelector('#careerGoalInput').value.trim();
        state.goals = el.querySelector('#globalGoals').value;
        state.notes = el.querySelector('#globalNotes').value;
        persist();
        toast('Goals and notes saved.');
      };

      el.querySelector('#saveSettingsBtn').onclick = () => {
        state.settings.name = el.querySelector('#setName').value.trim() || 'Learner';
        state.settings.primaryPath = el.querySelector('#setPrimaryPath').value;
        state.settings.weeklyHoursTarget = Math.max(1,Number(el.querySelector('#setWeeklyHours').value||10));
        state.settings.weeklySkillsTarget = Math.max(1,Number(el.querySelector('#setWeeklySkills').value||2));
        state.settings.streakTarget = Math.max(1,Number(el.querySelector('#setStreakTarget').value||7));
        state.settings.dailyHoursTarget = Math.max(0.25,Number(el.querySelector('#setDailyTarget').value||1));
        state.settings.preferredHours = el.querySelector('#setPreferredHours').value.trim();
        state.settings.startDate = el.querySelector('#setStartDate').value || isoDate(new Date());
        state.selectedPath = state.settings.primaryPath;
        persist();
        toast('Settings saved.');
      };

      el.querySelector('#exportBtn').onclick = () => {
        const blob = new Blob([JSON.stringify(state,null,2)],{type:'application/json'});
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'data-career-dashboard-backup.json';
        a.click();
        URL.revokeObjectURL(url);
      };

      el.querySelector('#importInput').onchange = (ev) => {
        const file = ev.target.files?.[0];
        if(!file) return;
        const reader = new FileReader();
        reader.onload = () => {
          try {
            state = mergeState(JSON.parse(String(reader.result||'{}')));
            persist(false);
            toast('Import successful.');
          } catch { toast('Invalid JSON file.'); }
        };
        reader.readAsText(file);
      };

      el.querySelector('#resetBtn').onclick = () => {
        if(!confirm('Reset all data to demo defaults?')) return;
        state = defaultState();
        persist(false);
        toast('Reset to demo data complete.');
      };
    }

    function renderPalette(){
      const input = document.getElementById('paletteInput');
      const q = input.value.trim().toLowerCase();
      const results = [];
      for(const s of state.skills){
        if(!q || `${s.name} ${s.path} ${s.notes} ${s.goal}`.toLowerCase().includes(q)) results.push({type:'Skill',title:s.name,subtitle:`${s.path} • ${s.status}`,action:()=>{showSection('roadmap');openSkillDrawer(s.id);}});
      }
      for(const r of state.resources){
        if(!q || `${r.name} ${r.path} ${r.category} ${r.notes}`.toLowerCase().includes(q)) results.push({type:'Resource',title:r.name,subtitle:`${r.path} • ${r.status}`,action:()=>showSection('resources')});
      }
      for(const p of Object.keys(PATHS)){
        if(!q || p.toLowerCase().includes(q) || PATHS[p].desc.toLowerCase().includes(q)) results.push({type:'Career Path',title:p,subtitle:PATHS[p].desc,action:()=>{state.selectedPath=p;showSection('career');renderCareerPaths();}});
      }
      if(!q || state.notes.toLowerCase().includes(q) || state.goals.toLowerCase().includes(q)){
        results.push({type:'Notes',title:'Goals & Notes',subtitle:'Open personal goals and reflections',action:()=>showSection('goals')});
      }

      const holder = document.getElementById('paletteResults');
      if(!results.length){
        holder.innerHTML = `<div class="surface flat"><strong>No matches yet.</strong><div class="tiny muted">Try searching SQL, streak, Data Engineer, or resources.</div></div>`;
        return;
      }
      holder.innerHTML = results.slice(0,30).map((r,i)=>`<button class="result-item" data-result="${i}" type="button"><div class="pill">${r.type}</div><strong>${esc(r.title)}</strong><div class="tiny muted">${esc(r.subtitle)}</div></button>`).join('');
      holder.querySelectorAll('[data-result]').forEach(btn => btn.onclick = () => { const r = results[Number(btn.dataset.result)]; r.action(); closePalette(); });
      document.getElementById('palette').dataset.firstResult = String(results.length?0:-1);
      document.getElementById('palette')._results = results;
    }

    function openPalette(){
      ui.paletteOpen = true;
      const p = document.getElementById('palette');
      p.classList.add('open');
      p.setAttribute('aria-hidden','false');
      const input = document.getElementById('paletteInput');
      input.value='';
      renderPalette();
      setTimeout(()=>input.focus(),20);
    }

    function closePalette(){
      ui.paletteOpen = false;
      const p = document.getElementById('palette');
      p.classList.remove('open');
      p.setAttribute('aria-hidden','true');
    }

    function animateCounters(root=document){
      root.querySelectorAll('[data-count]').forEach(el => {
        const target = Number(el.dataset.count);
        if(!Number.isFinite(target)) return;
        const decimals = String(el.dataset.count).includes('.') ? 1 : 0;
        const start = 0;
        const t0 = performance.now();
        const duration = 500;
        const step = (t) => {
          const p = Math.min(1,(t-t0)/duration);
          const v = start + (target-start)*p;
          el.textContent = decimals ? v.toFixed(decimals) : String(Math.round(v));
          if(p<1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
    }

    function bindGlobalEvents(){
      document.getElementById('drawerClose').onclick = closeSkillDrawer;
      document.getElementById('skillDrawer').addEventListener('click',(e)=>{ if(e.target.id==='skillDrawer') closeSkillDrawer(); });
      document.getElementById('searchBtn').onclick = openPalette;
      document.getElementById('palette').addEventListener('click',(e)=>{ if(e.target.id==='palette') closePalette(); });
      document.getElementById('paletteInput').oninput = renderPalette;

      document.addEventListener('keydown',(e)=>{
        if((e.ctrlKey || e.metaKey) && e.key.toLowerCase()==='k'){
          e.preventDefault();
          ui.paletteOpen ? closePalette() : openPalette();
        }
        if(e.key==='Escape'){
          if(ui.paletteOpen) closePalette();
          const drawer = document.getElementById('skillDrawer');
          if(drawer.classList.contains('open')) closeSkillDrawer();
        }
        if(e.key==='Enter' && ui.paletteOpen){
          const results = document.getElementById('palette')._results || [];
          if(results.length){
            results[0].action();
            closePalette();
          }
        }
      });

      window.__go = (id) => showSection(id);
    }

    function renderAll(){
      renderStorageNotice();
      renderTopProfile();
      renderNav();
      renderDashboard();
      renderCareerPaths();
      renderRoadmap();
      renderProgress();
      renderResources();
      renderSkills();
      renderActivity();
      renderGoals();
      showSection(ui.section || 'dashboard');
    }

    bindGlobalEvents();
    renderAll();
  </script>
</body>
</html>
